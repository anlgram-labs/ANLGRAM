# ANLGRAM Environment Configuration
# Copia este archivo a .env y completa los valores privados.
# El archivo .env está protegido por .gitignore y NUNCA se sube a GitHub.

# TON Center API Key (obtenida desde @toncenter_bot en Telegram)
TONCENTER_API_KEY=

# TonAPI Key (si se utiliza como proveedor primario en tonapi.io)
TONAPI_KEY=

# Imgur Client IDs (separados por coma para subida de imágenes descentralizadas)
IMGUR_CLIENT_IDS=
