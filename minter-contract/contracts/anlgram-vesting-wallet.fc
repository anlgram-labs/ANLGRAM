;; ═══════════════════════════════════════════════════════════════════════════
;; ANLGRAM Jetton Linear Vesting Contract
;; File: minter-contract/contracts/anlgram-vesting-wallet.fc
;; Standard: TEP-74 Jetton Compatible Non-Custodial Linear Vesting
;;
;; Enforceable On-Chain Guarantees:
;; 1. Non-Custodial: Creator cannot withdraw tokens once deposited.
;; 2. Strict Beneficiary Authorization: Only beneficiary_address can claim.
;; 3. Cliff Enforcement: Zero tokens can be claimed before now() >= start + cliff.
;; 4. Mathematical Linear Vesting: muldiv(total_locked, elapsed, total_duration).
;; 5. Re-entrancy & Double-Claim Protection: State updated before outgoing transfer.
;; 6. Authenticated Jetton Notification: Verifies sender is authentic Jetton Wallet.
;; 7. Decimals & Bounce Handling: TEP-74 compliant 0x0f8a7ea5 dispatch.
;; ═══════════════════════════════════════════════════════════════════════════

#include "imports/stdlib.fc";
#include "imports/params.fc";
#include "imports/constants.fc";
#include "imports/jetton-utils.fc";
#include "imports/op-codes.fc";
#include "imports/utils.fc";
#pragma version >=0.2.0;

;; ── Opcodes ────────────────────────────────────────────────────────────────
int op::claim_vested()          asm "0x414e4c76 PUSHINT"; ;; Beneficiary -> Vesting: claim unlocked tokens
int op::jetton_transfer()       asm "0x0f8a7ea5 PUSHINT"; ;; Vesting -> Vesting JWallet: transfer to beneficiary
int op::transfer_notification() asm "0x7362d09c PUSHINT"; ;; Vesting JWallet -> Vesting: tokens received notification
int op::excesses()              asm "0xd53276db PUSHINT"; ;; Excess gas return

;; ── Error Codes ────────────────────────────────────────────────────────────
int error::unauthorized()               asm "401 PUSHINT"; ;; Sender is not authorized
int error::cliff_not_reached()          asm "402 PUSHINT"; ;; Cliff period has not elapsed
int error::unauthorized_jwallet()       asm "403 PUSHINT"; ;; Transfer notification not from authentic JWallet
int error::insufficient_deposit()       asm "404 PUSHINT"; ;; Deposit amount less than configured schedule
int error::nothing_to_claim()           asm "405 PUSHINT"; ;; 0 claimable tokens available
int error::not_initialized()            asm "406 PUSHINT"; ;; Contract has not received initial Jetton deposit
int error::already_initialized()        asm "407 PUSHINT"; ;; Contract already received initial deposit
int error::insufficient_gas()           asm "408 PUSHINT"; ;; Inbound message attached gas too low

;; ── Storage Scheme ─────────────────────────────────────────────────────────
;; storage#_ 
;;   creator_address:MsgAddress 
;;   beneficiary_address:MsgAddress 
;;   jetton_master_address:MsgAddress 
;;   jetton_wallet_code:^Cell
;;   schedule:^[
;;     vesting_start_time:uint32 
;;     cliff_duration:uint32 
;;     vesting_total_duration:uint32 
;;     total_locked_amount:Coins 
;;     claimed_amount:Coins 
;;     is_initialized:uint1
;;   ] = Storage;

(slice, slice, slice, cell, int, int, int, int, int, int) load_data() inline {
    slice ds = get_data().begin_parse();
    slice creator_address = ds~load_msg_addr();
    slice beneficiary_address = ds~load_msg_addr();
    slice jetton_master_address = ds~load_msg_addr();
    cell jetton_wallet_code = ds~load_ref();
    
    slice ss = ds~load_ref().begin_parse();
    int vesting_start_time = ss~load_uint(32);
    int cliff_duration = ss~load_uint(32);
    int vesting_total_duration = ss~load_uint(32);
    int total_locked_amount = ss~load_coins();
    int claimed_amount = ss~load_coins();
    int is_initialized = ss~load_uint(1);
    
    return (
        creator_address,
        beneficiary_address,
        jetton_master_address,
        jetton_wallet_code,
        vesting_start_time,
        cliff_duration,
        vesting_total_duration,
        total_locked_amount,
        claimed_amount,
        is_initialized
    );
}

() save_data(
    slice creator_address,
    slice beneficiary_address,
    slice jetton_master_address,
    cell jetton_wallet_code,
    int vesting_start_time,
    int cliff_duration,
    int vesting_total_duration,
    int total_locked_amount,
    int claimed_amount,
    int is_initialized
) impure inline {
    cell schedule_cell = begin_cell()
        .store_uint(vesting_start_time, 32)
        .store_uint(cliff_duration, 32)
        .store_uint(vesting_total_duration, 32)
        .store_coins(total_locked_amount)
        .store_coins(claimed_amount)
        .store_uint(is_initialized, 1)
        .end_cell();

    set_data(
        begin_cell()
            .store_slice(creator_address)
            .store_slice(beneficiary_address)
            .store_slice(jetton_master_address)
            .store_ref(jetton_wallet_code)
            .store_ref(schedule_cell)
            .end_cell()
    );
}

;; ── Internal Message Handler ───────────────────────────────────────────────
() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { ;; ignore empty messages (e.g. pure TON top-ups)
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice sender_address = cs~load_msg_addr();

    (
        slice creator_address,
        slice beneficiary_address,
        slice jetton_master_address,
        cell jetton_wallet_code,
        int vesting_start_time,
        int cliff_duration,
        int vesting_total_duration,
        int total_locked_amount,
        int claimed_amount,
        int is_initialized
    ) = load_data();

    if (flags & 1) { ;; handle bounced message from authentic JWallet
        slice expected_jwallet = calculate_user_jetton_wallet_address(
            my_address(),
            jetton_master_address,
            jetton_wallet_code
        );
        if (equal_slices(sender_address, expected_jwallet)) {
            if (in_msg_body.slice_bits() >= 64) {
                in_msg_body~skip_bits(32); ;; skip 0xFFFFFFFF
                int bounced_op = in_msg_body~load_uint(32);
                if (bounced_op == op::jetton_transfer()) {
                    in_msg_body~skip_bits(64); ;; skip query_id
                    int bounced_amount = in_msg_body~load_coins();
                    claimed_amount -= bounced_amount;
                    if (claimed_amount < 0) { claimed_amount = 0; }
                    save_data(
                        creator_address, beneficiary_address, jetton_master_address, jetton_wallet_code,
                        vesting_start_time, cliff_duration, vesting_total_duration,
                        total_locked_amount, claimed_amount, is_initialized
                    );
                }
            }
        }
        return ();
    }

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    ;; ─────────────────────────────────────────────────────────────────────────
    ;; OP: TRANSFER NOTIFICATION (Initial Jetton Deposit from Creator)
    ;; ─────────────────────────────────────────────────────────────────────────
    if (op == op::transfer_notification()) {
        int jetton_amount = in_msg_body~load_coins();
        slice from_address = in_msg_body~load_msg_addr();

        ;; 1. Authenticate that notification came from our deterministic Jetton Wallet
        slice expected_jwallet = calculate_user_jetton_wallet_address(
            my_address(),
            jetton_master_address,
            jetton_wallet_code
        );
        throw_unless(error::unauthorized_jwallet(), equal_slices(sender_address, expected_jwallet));

        ;; 2. Only allow initialization once
        throw_if(error::already_initialized(), is_initialized == 1);

        ;; 3. Verify sender is creator
        throw_unless(error::unauthorized(), equal_slices(from_address, creator_address));

        ;; 4. Verify received amount covers configured total_locked_amount
        throw_unless(error::insufficient_deposit(), jetton_amount >= total_locked_amount);

        ;; 5. Mark initialized and save
        save_data(
            creator_address,
            beneficiary_address,
            jetton_master_address,
            jetton_wallet_code,
            vesting_start_time,
            cliff_duration,
            vesting_total_duration,
            total_locked_amount,
            claimed_amount,
            1 ;; is_initialized = true
        );
        return ();
    }

    ;; ─────────────────────────────────────────────────────────────────────────
    ;; OP: CLAIM VESTED TOKENS (Beneficiary Withdrawal)
    ;; ─────────────────────────────────────────────────────────────────────────
    if (op == op::claim_vested()) {
        ;; 1. Check initialized
        throw_unless(error::not_initialized(), is_initialized == 1);

        ;; 2. Authentication: only permitted beneficiary can claim
        throw_unless(error::unauthorized(), equal_slices(sender_address, beneficiary_address));

        ;; 3. Gas check: minimum 0.04 TON required to cover Jetton transfer fees
        throw_unless(error::insufficient_gas(), msg_value >= 40000000);

        int current_time = now();

        ;; 4. Cliff check: before start + cliff, zero tokens can be claimed
        int cliff_end = vesting_start_time + cliff_duration;
        throw_unless(error::cliff_not_reached(), current_time >= cliff_end);

        ;; 5. Mathematical Linear Vesting Calculation
        int vested_amount = 0;
        int vesting_end = vesting_start_time + vesting_total_duration;

        if (current_time >= vesting_end) {
            vested_amount = total_locked_amount;
        } else {
            int elapsed = current_time - vesting_start_time;
            vested_amount = muldiv(total_locked_amount, elapsed, vesting_total_duration);
        }

        ;; 6. Calculate claimable amount
        int claimable = vested_amount - claimed_amount;
        throw_unless(error::nothing_to_claim(), claimable > 0);

        ;; 7. Checks-Effects-Interactions: update claimed_amount BEFORE dispatching transfer
        claimed_amount += claimable;
        save_data(
            creator_address,
            beneficiary_address,
            jetton_master_address,
            jetton_wallet_code,
            vesting_start_time,
            cliff_duration,
            vesting_total_duration,
            total_locked_amount,
            claimed_amount,
            is_initialized
        );

        ;; 8. Calculate our Jetton Wallet address
        slice my_jwallet = calculate_user_jetton_wallet_address(
            my_address(),
            jetton_master_address,
            jetton_wallet_code
        );

        ;; 9. Construct TEP-74 Jetton transfer body
        ;; op::transfer query_id:uint64 amount:Coins to:MsgAddress response:MsgAddress
        ;; custom_payload:Maybe ^Cell forward_ton_amount:Coins forward_payload:Either
        var transfer_body = begin_cell()
            .store_uint(op::jetton_transfer(), 32)
            .store_uint(query_id, 64)
            .store_coins(claimable)
            .store_slice(beneficiary_address)
            .store_slice(beneficiary_address) ;; response_destination receives excess gas
            .store_uint(0, 1)                 ;; null custom_payload
            .store_coins(1)                   ;; 1 nanoTON forward_ton_amount
            .store_uint(0, 1)                 ;; empty forward_payload
            .end_cell();

        ;; 10. Dispatch transfer message to our Jetton Wallet (mode: 64 carries remaining gas)
        var msg = begin_cell()
            .store_uint(0x18, 6)              ;; bounceable
            .store_slice(my_jwallet)
            .store_coins(0)                   ;; mode 64 sets amount from remaining gas
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(transfer_body);

        send_raw_message(msg.end_cell(), 64);
        return ();
    }

    throw(0xffff); ;; unknown op
}

;; ── Get Methods for On-Chain Inspection ────────────────────────────────────

(int, int, int, int, int, int, slice, slice, slice, int) get_vesting_data() method_id {
    (
        slice creator_address,
        slice beneficiary_address,
        slice jetton_master_address,
        cell jetton_wallet_code,
        int vesting_start_time,
        int cliff_duration,
        int vesting_total_duration,
        int total_locked_amount,
        int claimed_amount,
        int is_initialized
    ) = load_data();

    int current_time = now();
    int claimable = 0;

    if ((is_initialized == 1) & (current_time >= vesting_start_time + cliff_duration)) {
        int vested = 0;
        if (current_time >= vesting_start_time + vesting_total_duration) {
            vested = total_locked_amount;
        } else {
            vested = muldiv(total_locked_amount, current_time - vesting_start_time, vesting_total_duration);
        }
        claimable = vested - claimed_amount;
        if (claimable < 0) {
            claimable = 0;
        }
    }

    return (
        total_locked_amount,
        claimed_amount,
        claimable,
        vesting_start_time,
        cliff_duration,
        vesting_total_duration,
        beneficiary_address,
        creator_address,
        jetton_master_address,
        is_initialized
    );
}

int get_claimable_at(int target_timestamp) method_id {
    (
        slice creator_address,
        slice beneficiary_address,
        slice jetton_master_address,
        cell jetton_wallet_code,
        int vesting_start_time,
        int cliff_duration,
        int vesting_total_duration,
        int total_locked_amount,
        int claimed_amount,
        int is_initialized
    ) = load_data();

    if (is_initialized == 0) {
        return 0;
    }
    if (target_timestamp < vesting_start_time + cliff_duration) {
        return 0;
    }
    if (target_timestamp >= vesting_start_time + vesting_total_duration) {
        return total_locked_amount - claimed_amount;
    }
    int vested = muldiv(total_locked_amount, target_timestamp - vesting_start_time, vesting_total_duration);
    int claimable = vested - claimed_amount;
    if (claimable < 0) {
        return 0;
    }
    return claimable;
}
