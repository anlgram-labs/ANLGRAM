;; ANLGRAM Launchpad — Deterministic Bonding Curve Smart Contract
;; File: minter-contract/contracts/anlgram-bonding-curve.fc
;; Version: 1.0.0
;; 
;; Architectural Rules:
;; 1. Constant Product AMM (x * y = k) with Price-Continuity Derived Virtual Reserves.
;; 2. Strict Integer Arithmetic (BigInt) with Solvency-Preserving Truncation.
;; 3. 8-State Finite State Machine (UNINITIALIZED -> ACTIVE -> GRADUATED).
;; 4. Non-Bounceable Sell Handling with Explicit Jetton Refund on Slippage Violation.
;; 5. Segregated Reserve Accounting: real_ton, accrued_fees, storage_reserve.
;; 6. Dedicated LP Locker Integration for Permanent Liquidity Lock.

#include "imports/stdlib.fc";
#include "imports/params.fc";
#include "imports/constants.fc";
#include "imports/jetton-utils.fc";
#include "imports/op-codes.fc";
#include "imports/utils.fc";
#pragma version >=0.2.0;

;; Op-Codes
const int op::init_launchpad     = 0x414e4c01;
const int op::confirm_custody    = 0x414e4c02;
const int op::activate_trading   = 0x414e4c03;
const int op::buy                = 0x414e4c04;
const int op::sweep_fees         = 0x414e4c05;
const int op::migrate_dex        = 0x414e4c06;

;; Lifecycle States
const int STATE_UNINITIALIZED        = 0;
const int STATE_INITIALIZING         = 1;
const int STATE_RENOUNCE_PENDING     = 2;
const int STATE_ACTIVE               = 3;
const int STATE_GRADUATION_PENDING   = 4;
const int STATE_MIGRATING            = 5;
const int STATE_GRADUATED            = 6;
const int STATE_MIGRATION_FAILED     = 7;

;; Error Codes
const int ERROR_UNAUTHORIZED         = 401;
const int ERROR_INVALID_STATE        = 402;
const int ERROR_CURVE_GRADUATED      = 403;
const int ERROR_SLIPPAGE_EXCEEDED    = 405;
const int ERROR_SOLVENCY_VIOLATION   = 406;
const int ERROR_ZERO_INPUT           = 407;
const int ERROR_INSUFFICIENT_GAS     = 408;

const int BPS_DENOMINATOR            = 10000;
const int GAS_OVERHEAD_TRADE         = 25000000; ;; 0.025 TON gas for internal message routing
const int MIN_STORAGE_RESERVE        = 50000000; ;; 0.050 TON minimum balance for TVM rent

;; ----------------------------------------------------------------------------
;; Storage Management
;; ----------------------------------------------------------------------------

(int, slice, slice, slice, slice, slice, slice, slice, int, int, int, int, int, int, int, int, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    int state = ds~load_uint(8);
    slice admin_address = ds~load_msg_addr();
    slice creator_address = ds~load_msg_addr();
    slice treasury_address = ds~load_msg_addr();

    cell c2 = ds~load_ref();
    slice s2 = c2.begin_parse();
    slice jetton_master_address = s2~load_msg_addr();
    slice curve_jetton_wallet = s2~load_msg_addr();
    cell c2_sub = s2~load_ref();
    slice s2_sub = c2_sub.begin_parse();
    slice dex_router_address = s2_sub~load_msg_addr();
    slice lp_locker_address = s2_sub~load_msg_addr();

    cell c3 = ds~load_ref();
    slice s3 = c3.begin_parse();
    int real_ton_reserve = s3~load_coins();
    int real_token_reserve = s3~load_coins();
    int accrued_protocol_fees = s3~load_coins();
    int virtual_ton_reserve = s3~load_coins();
    int virtual_token_reserve = s3~load_coins();

    cell c4 = ds~load_ref();
    slice s4 = c4.begin_parse();
    int graduation_threshold_ton = s4~load_coins();
    int protocol_fee_bps = s4~load_uint(16);
    int dex_tokens_escrow = s4~load_coins();
    cell jetton_wallet_code = s4~load_ref();

    return (
        state, admin_address, creator_address, treasury_address,
        jetton_master_address, curve_jetton_wallet, dex_router_address, lp_locker_address,
        real_ton_reserve, real_token_reserve, accrued_protocol_fees,
        virtual_ton_reserve, virtual_token_reserve,
        graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
        jetton_wallet_code
    );
}

() save_data(
    int state, slice admin_address, slice creator_address, slice treasury_address,
    slice jetton_master_address, slice curve_jetton_wallet, slice dex_router_address, slice lp_locker_address,
    int real_ton_reserve, int real_token_reserve, int accrued_protocol_fees,
    int virtual_ton_reserve, int virtual_token_reserve,
    int graduation_threshold_ton, int protocol_fee_bps, int dex_tokens_escrow,
    cell jetton_wallet_code
) impure inline {
    set_data(
        begin_cell()
            .store_uint(state, 8)
            .store_slice(admin_address)
            .store_slice(creator_address)
            .store_slice(treasury_address)
            .store_ref(
                begin_cell()
                    .store_slice(jetton_master_address)
                    .store_slice(curve_jetton_wallet)
                    .store_ref(
                        begin_cell()
                            .store_slice(dex_router_address)
                            .store_slice(lp_locker_address)
                            .end_cell()
                    )
                    .end_cell()
            )
            .store_ref(
                begin_cell()
                    .store_coins(real_ton_reserve)
                    .store_coins(real_token_reserve)
                    .store_coins(accrued_protocol_fees)
                    .store_coins(virtual_ton_reserve)
                    .store_coins(virtual_token_reserve)
                    .end_cell()
            )
            .store_ref(
                begin_cell()
                    .store_coins(graduation_threshold_ton)
                    .store_uint(protocol_fee_bps, 16)
                    .store_coins(dex_tokens_escrow)
                    .store_ref(jetton_wallet_code)
                    .end_cell()
            )
            .end_cell()
    );
}

;; ----------------------------------------------------------------------------
;; Helper: Send TEP-74 Outbound Jetton Transfer
;; ----------------------------------------------------------------------------
() send_jettons(slice jetton_wallet, slice to_address, int token_amount, slice response_address, int forward_ton_amount) impure inline {
    var msg_body = begin_cell()
        .store_uint(op::transfer(), 32)
        .store_uint(cur_lt(), 64)
        .store_coins(token_amount)
        .store_slice(to_address)
        .store_slice(response_address)
        .store_uint(0, 1) ;; null custom payload
        .store_coins(forward_ton_amount)
        .store_uint(0, 1) ;; empty forward payload
        .end_cell();

    var msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(jetton_wallet)
        .store_coins(40000000) ;; 0.040 TON attached for gas
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(msg_body);

    send_raw_message(msg.end_cell(), 1);
}

;; ----------------------------------------------------------------------------
;; Inbound Message Dispatcher
;; ----------------------------------------------------------------------------

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return (); ;; Accept pure TON to fund storage reserve
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return (); ;; Ignore standard bounced messages
    }
    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (
        int state, slice admin_address, slice creator_address, slice treasury_address,
        slice jetton_master_address, slice curve_jetton_wallet, slice dex_router_address, slice lp_locker_address,
        int real_ton_reserve, int real_token_reserve, int accrued_protocol_fees,
        int virtual_ton_reserve, int virtual_token_reserve,
        int graduation_threshold_ton, int protocol_fee_bps, int dex_tokens_escrow,
        cell jetton_wallet_code
    ) = load_data();

    ;; ------------------------------------------------------------------------
    ;; 1. OP::INIT_LAUNCHPAD (One-Time Setup)
    ;; ------------------------------------------------------------------------
    if (op == op::init_launchpad) {
        throw_unless(ERROR_UNAUTHORIZED, equal_slices(sender_address, admin_address));
        throw_unless(ERROR_INVALID_STATE, state == STATE_UNINITIALIZED);

        slice new_master = in_msg_body~load_msg_addr();
        slice new_curve_wallet = in_msg_body~load_msg_addr();
        cell c_ref = in_msg_body~load_ref();
        slice s_ref = c_ref.begin_parse();
        slice new_router = s_ref~load_msg_addr();
        slice new_locker = s_ref~load_msg_addr();
        cell new_wallet_code = in_msg_body~load_ref();

        ;; If not explicitly passed, compute curve's authentic Jetton Wallet address deterministically
        if (new_curve_wallet.preload_uint(2) == 0) {
            cell state_init = calculate_jetton_wallet_state_init(my_address(), new_master, new_wallet_code);
            new_curve_wallet = calculate_jetton_wallet_address(state_init);
        }

        state = STATE_INITIALIZING;
        save_data(
            state, admin_address, creator_address, treasury_address,
            new_master, new_curve_wallet, new_router, new_locker,
            real_ton_reserve, real_token_reserve, accrued_protocol_fees,
            virtual_ton_reserve, virtual_token_reserve,
            graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
            new_wallet_code
        );
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 2. OP::TRANSFER_NOTIFICATION (Inbound Jettons: Sell OR Initial Custody)
    ;; ------------------------------------------------------------------------
    if (op == op::transfer_notification()) {
        int token_amount = in_msg_body~load_coins();
        slice from_address = in_msg_body~load_msg_addr();

        ;; Security Gate: Sender MUST be the authentic Curve Jetton Wallet
        throw_unless(ERROR_UNAUTHORIZED, equal_slices(sender_address, curve_jetton_wallet));

        ;; SUB-FLOW A: Initial 1B Token Custody Receipt
        if (state == STATE_INITIALIZING) {
            ;; Verify receipt of entire 1 Billion tokens
            int total_expected = real_token_reserve + dex_tokens_escrow;
            throw_unless(410, token_amount == total_expected);

            ;; Send op::change_admin to Jetton Minter setting admin to addr_none
            var msg_body = begin_cell()
                .store_uint(3, 32) ;; change_admin opcode
                .store_uint(query_id, 64)
                .store_uint(0, 2)  ;; addr_none (permanent renounce)
                .end_cell();

            var msg = begin_cell()
                .store_uint(0x18, 6)
                .store_slice(jetton_master_address)
                .store_coins(20000000) ;; 0.02 TON for gas
                .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_ref(msg_body);

            send_raw_message(msg.end_cell(), 1);

            state = STATE_RENOUNCE_PENDING;
            save_data(
                state, admin_address, creator_address, treasury_address,
                jetton_master_address, curve_jetton_wallet, dex_router_address, lp_locker_address,
                real_ton_reserve, real_token_reserve, accrued_protocol_fees,
                virtual_ton_reserve, virtual_token_reserve,
                graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
                jetton_wallet_code
            );
            return ();
        }

        ;; SUB-FLOW B: Standard Token Sell Order
        ;; If curve is NOT active or graduated -> Trigger Safe Token Refund!
        if (state != STATE_ACTIVE) {
            send_jettons(curve_jetton_wallet, from_address, token_amount, from_address, 10000000);
            return ();
        }

        ;; Parse min_ton_out from forward_payload
        slice payload = in_msg_body~load_int(1) ? in_msg_body~load_ref().begin_parse() : in_msg_body;
        int min_ton_out = payload.slice_bits() >= 4 ? payload~load_coins() : 0;

        ;; Constant Product Math: dx_gross = floor(X * dy / (Y + dy))
        int X = real_ton_reserve + virtual_ton_reserve;
        int Y = real_token_reserve + virtual_token_reserve;
        int gross_ton_out = (X * token_amount) / (Y + token_amount);

        ;; Solvency Guard: Payout cannot exceed real TON reserve
        if (gross_ton_out > real_ton_reserve) {
            send_jettons(curve_jetton_wallet, from_address, token_amount, from_address, 10000000);
            return ();
        }

        int fee_ton = (gross_ton_out * protocol_fee_bps) / BPS_DENOMINATOR;
        int net_ton_out = gross_ton_out - fee_ton;

        ;; Slippage Guard: If net payout < min_ton_out -> Safe Token Refund!
        if (net_ton_out < min_ton_out) {
            send_jettons(curve_jetton_wallet, from_address, token_amount, from_address, 10000000);
            return ();
        }

        ;; State Update
        real_ton_reserve -= gross_ton_out;
        real_token_reserve += token_amount;
        accrued_protocol_fees += fee_ton;

        save_data(
            state, admin_address, creator_address, treasury_address,
            jetton_master_address, curve_jetton_wallet, dex_router_address, lp_locker_address,
            real_ton_reserve, real_token_reserve, accrued_protocol_fees,
            virtual_ton_reserve, virtual_token_reserve,
            graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
            jetton_wallet_code
        );

        ;; Send Net TON Payout to Seller
        var p_msg = begin_cell()
            .store_uint(0x10, 6) ;; non-bounceable
            .store_slice(from_address)
            .store_coins(net_ton_out)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::excesses(), 32)
            .store_uint(query_id, 64);
        send_raw_message(p_msg.end_cell(), 1);
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 3. OP::ACTIVATE_TRADING (Enables Public Buys & Sells)
    ;; ------------------------------------------------------------------------
    if (op == op::activate_trading) {
        throw_unless(ERROR_UNAUTHORIZED, equal_slices(sender_address, admin_address));
        throw_unless(ERROR_INVALID_STATE, state == STATE_RENOUNCE_PENDING);

        state = STATE_ACTIVE;
        save_data(
            state, admin_address, creator_address, treasury_address,
            jetton_master_address, curve_jetton_wallet, dex_router_address, lp_locker_address,
            real_ton_reserve, real_token_reserve, accrued_protocol_fees,
            virtual_ton_reserve, virtual_token_reserve,
            graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
            jetton_wallet_code
        );
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 4. OP::BUY (Public Token Purchase with Attached TON)
    ;; ------------------------------------------------------------------------
    if ((op == op::buy) | (op == 0)) {
        throw_unless(ERROR_CURVE_GRADUATED, state == STATE_ACTIVE);
        throw_unless(ERROR_INSUFFICIENT_GAS, msg_value > GAS_OVERHEAD_TRADE + 10000000);

        int min_tokens_out = 0;
        if (op == op::buy) {
            min_tokens_out = in_msg_body~load_coins();
        }

        int gross_ton_in = msg_value - GAS_OVERHEAD_TRADE;
        throw_unless(ERROR_ZERO_INPUT, gross_ton_in > 0);

        int fee_ton = (gross_ton_in * protocol_fee_bps) / BPS_DENOMINATOR;
        int net_ton = gross_ton_in - fee_ton;

        ;; Constant Product Math: dy = floor(Y * dx / (X + dx))
        int X = real_ton_reserve + virtual_ton_reserve;
        int Y = real_token_reserve + virtual_token_reserve;
        int tokens_out = (Y * net_ton) / (X + net_ton);

        int actual_net_ton = net_ton;
        int actual_fee_ton = fee_ton;
        int will_graduate = 0;

        ;; Graduation Capping: If purchase exhausts remaining curve inventory
        if (tokens_out >= real_token_reserve) {
            tokens_out = real_token_reserve;
            will_graduate = 1;

            ;; Recompute exact net TON to clear inventory
            int targetY = Y - real_token_reserve;
            if (targetY > 0) {
                int reqX = (virtual_ton_reserve * (real_token_reserve + virtual_token_reserve) + targetY - 1) / targetY;
                if (reqX > X) {
                    actual_net_ton = reqX - X;
                    int netMultiplier = BPS_DENOMINATOR - protocol_fee_bps;
                    int actualGross = (actual_net_ton * BPS_DENOMINATOR + netMultiplier - 1) / netMultiplier;
                    actual_fee_ton = actualGross - actual_net_ton;
                }
            }
        }

        ;; Threshold Check
        if (real_ton_reserve + actual_net_ton >= graduation_threshold_ton) {
            will_graduate = 1;
        }

        throw_unless(ERROR_SLIPPAGE_EXCEEDED, tokens_out >= min_tokens_out);

        real_ton_reserve += actual_net_ton;
        real_token_reserve -= tokens_out;
        accrued_protocol_fees += actual_fee_ton;

        if (will_graduate) {
            state = STATE_GRADUATION_PENDING;
        }

        save_data(
            state, admin_address, creator_address, treasury_address,
            jetton_master_address, curve_jetton_wallet, dex_router_address, lp_locker_address,
            real_ton_reserve, real_token_reserve, accrued_protocol_fees,
            virtual_ton_reserve, virtual_token_reserve,
            graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
            jetton_wallet_code
        );

        ;; Deliver Purchased Jettons to Buyer
        send_jettons(curve_jetton_wallet, sender_address, tokens_out, sender_address, 10000000);
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 5. OP::SWEEP_FEES (Treasury Protocol Fee Withdrawal)
    ;; ------------------------------------------------------------------------
    if (op == op::sweep_fees) {
        throw_unless(ERROR_UNAUTHORIZED, equal_slices(sender_address, treasury_address));
        throw_unless(415, accrued_protocol_fees > 0);

        int sweep_amount = accrued_protocol_fees;
        accrued_protocol_fees = 0;

        save_data(
            state, admin_address, creator_address, treasury_address,
            jetton_master_address, curve_jetton_wallet, dex_router_address, lp_locker_address,
            real_ton_reserve, real_token_reserve, accrued_protocol_fees,
            virtual_ton_reserve, virtual_token_reserve,
            graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
            jetton_wallet_code
        );

        var msg = begin_cell()
            .store_uint(0x10, 6)
            .store_slice(treasury_address)
            .store_coins(sweep_amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::excesses(), 32)
            .store_uint(query_id, 64);
        send_raw_message(msg.end_cell(), 1);
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 6. OP::MIGRATE_DEX (Seeds Initial DEX Liquidity & Locks LP in LP Locker)
    ;; ------------------------------------------------------------------------
    if (op == op::migrate_dex) {
        throw_unless(ERROR_INVALID_STATE, state == STATE_GRADUATION_PENDING);
        throw_unless(ERROR_UNAUTHORIZED, equal_slices(sender_address, admin_address) | equal_slices(sender_address, creator_address));

        state = STATE_GRADUATED;
        int ton_to_migrate = real_ton_reserve;
        int tokens_to_migrate = dex_tokens_escrow;

        real_ton_reserve = 0;
        dex_tokens_escrow = 0;

        save_data(
            state, admin_address, creator_address, treasury_address,
            jetton_master_address, curve_jetton_wallet, dex_router_address, lp_locker_address,
            real_ton_reserve, real_token_reserve, accrued_protocol_fees,
            virtual_ton_reserve, virtual_token_reserve,
            graduation_threshold_ton, protocol_fee_bps, dex_tokens_escrow,
            jetton_wallet_code
        );

        ;; Transfer graduation escrow tokens to DEX Router with LP receiver set to lp_locker_address
        send_jettons(curve_jetton_wallet, dex_router_address, tokens_to_migrate, lp_locker_address, 100000000);

        ;; Transfer real TON liquidity principal to DEX Router
        var msg = begin_cell()
            .store_uint(0x10, 6)
            .store_slice(dex_router_address)
            .store_coins(ton_to_migrate)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::deposit(), 32)
            .store_uint(query_id, 64);
        send_raw_message(msg.end_cell(), 1);
        return ();
    }

    throw(error::unknown_op());
}

;; ----------------------------------------------------------------------------
;; GET METHODS (Read-Only Public Inspection)
;; ----------------------------------------------------------------------------

(int, slice, slice, slice, int, int, int, int, int, int, int) get_curve_state() method_id {
    (
        int state, _, slice creator_address, slice treasury_address,
        slice jetton_master_address, _, _, _,
        int real_ton_reserve, int real_token_reserve, int accrued_protocol_fees,
        int virtual_ton_reserve, int virtual_token_reserve,
        int graduation_threshold_ton, int protocol_fee_bps, _, _
    ) = load_data();

    int X = real_ton_reserve + virtual_ton_reserve;
    int Y = real_token_reserve + virtual_token_reserve;
    int spot_price_nano = Y > 0 ? (X * 1000000000) / Y : 0;

    return (
        state, creator_address, treasury_address, jetton_master_address,
        real_ton_reserve, real_token_reserve, accrued_protocol_fees,
        spot_price_nano, virtual_ton_reserve, virtual_token_reserve,
        graduation_threshold_ton
    );
}

(int, int, int) get_buy_quote(int gross_ton_in) method_id {
    if (gross_ton_in <= GAS_OVERHEAD_TRADE) {
        return (0, 0, 0);
    }
    (
        _, _, _, _, _, _, _, _,
        int real_ton_reserve, int real_token_reserve, _,
        int virtual_ton_reserve, int virtual_token_reserve,
        _, int protocol_fee_bps, _, _
    ) = load_data();

    int effective_in = gross_ton_in - GAS_OVERHEAD_TRADE;
    int fee_ton = (effective_in * protocol_fee_bps) / BPS_DENOMINATOR;
    int net_ton = effective_in - fee_ton;

    int X = real_ton_reserve + virtual_ton_reserve;
    int Y = real_token_reserve + virtual_token_reserve;
    int tokens_out = (Y * net_ton) / (X + net_ton);

    if (tokens_out > real_token_reserve) {
        tokens_out = real_token_reserve;
    }
    return (tokens_out, fee_ton, net_ton);
}

(int, int, int) get_sell_quote(int tokens_in) method_id {
    if (tokens_in <= 0) {
        return (0, 0, 0);
    }
    (
        _, _, _, _, _, _, _, _,
        int real_ton_reserve, int real_token_reserve, _,
        int virtual_ton_reserve, int virtual_token_reserve,
        _, int protocol_fee_bps, _, _
    ) = load_data();

    int X = real_ton_reserve + virtual_ton_reserve;
    int Y = real_token_reserve + virtual_token_reserve;
    int gross_ton_out = (X * tokens_in) / (Y + tokens_in);

    if (gross_ton_out > real_ton_reserve) {
        return (0, 0, 0); ;; Solvency limit
    }

    int fee_ton = (gross_ton_out * protocol_fee_bps) / BPS_DENOMINATOR;
    int net_ton_out = gross_ton_out - fee_ton;
    return (net_ton_out, gross_ton_out, fee_ton);
}
