;; Development-only VNext migration-permit consumer. No custody/refund authority.
;; No upgrade, admin withdrawal, external-message or signing-key rotation path.
#include "imports/stdlib.fc";
#include "imports/vnext-migration-template.fc";
#pragma version >=0.2.0;
;; root version:uint8 ^immutable_cfg permits:(HashmapE 8 ^record)
;; cfg root:uint64 key:uint256 versions:uint256 lp_intent:uint256
;;     ^(curve:MsgAddress migrator:MsgAddress master:MsgAddress)
;; record state:uint2 ^signed_permit: staged0, granted1, revoked2.
;; No financial execution gate is enabled.
(cell,cell) config() inline {
    slice s = get_data().begin_parse();throw_unless(408,s~load_uint(8) == 1);
    cell cfg = s~load_ref();cell permits = s~load_dict();if(s.slice_bits()) { s~load_dict(); } s.end_parse();return(cfg,permits);
}
cell migration_binding() inline { slice s = get_data().begin_parse();s~load_uint(8);s~load_ref();s~load_dict();return s.slice_bits() ? s~load_dict() : null(); }
() save(cell cfg,cell permits) impure inline {
    set_data(begin_cell().store_uint(1,8).store_ref(cfg).store_dict(permits).store_dict(migration_binding()).end_cell());
}
(int,int,int,int,int,int,int,int,int,int) validate(cell permit,cell cfg,int fresh) impure inline {
    cell network = config_param(19);throw_if(408,cell_null?(network));slice n = network.begin_parse();throw_unless(408,n~load_int(32) == -3);n.end_parse();
    slice c = cfg.begin_parse();int root = c~load_uint(64);int key = c~load_uint(256);int versions = c~load_uint(256);int intent = c~load_uint(256);
    slice parties = c~load_ref().begin_parse();slice curve = parties~load_msg_addr();slice migrator = parties~load_msg_addr();slice master = parties~load_msg_addr();
    throw_unless(408,migrator.preload_uint(2) == 0);parties~load_ref();cell bound = migration_binding();throw_if(409,cell_null?(bound));slice b = bound.begin_parse();migrator = b~load_msg_addr();
    parties.end_parse();c.end_parse();
    throw_unless(401,key != 0);slice s = permit.begin_parse();
    throw_unless(408,(s~load_uint(32) == 0x414e5650) & (s~load_uint(8) == 1) & (s~load_int(32) == -3));
    int phase = s~load_uint(8);int q = s~load_uint(64);int nonce = s~load_uint(64);int starts = s~load_uint(32);int deadline = s~load_uint(32);
    int ton = s~load_coins();int tokens = s~load_coins();int minimum = s~load_coins();
    slice scope = s~load_ref().begin_parse();slice project = s~load_ref().begin_parse();slice epochs = s~load_ref().begin_parse();s.end_parse();
    throw_unless(408,equal_slices(scope~load_msg_addr(),my_address()) & equal_slices(scope~load_msg_addr(),curve) & equal_slices(scope~load_msg_addr(),migrator));scope.end_parse();
    throw_unless(408,equal_slices(project~load_msg_addr(),master) & (project~load_uint(256) == intent));project.end_parse();
    int ce = epochs~load_uint(64);int fe = epochs~load_uint(64);int de = epochs~load_uint(64);throw_unless(408,epochs~load_uint(256) == versions);epochs.end_parse();
    throw_unless(409,((phase == 1) | (phase == 2)) & (q == root) & (q > 0) & (q < (1 << 62)) & (nonce > 0));
    throw_unless(409,(deadline > starts) & (deadline <= starts + 60));if(fresh) { throw_unless(409,(starts <= now()) & (now() < deadline)); }
    throw_unless(409,(ton >= 300000000000) & (tokens == 200000000000000000) & (minimum > 0) & (ce > 0));
    throw_unless(409,(phase == 1) ? ((fe == 0) & (de == 0)) : ((fe > 0) & (de > 0)));
    return(phase,q,nonce,deadline,ton,tokens,minimum,ce,fe,de);
}
() refund(slice recipient,int previous,int q) impure inline {
    raw_reserve(previous,0);
    send_raw_message(begin_cell().store_uint(0x10,6).store_slice(recipient).store_coins(0).store_uint(0,107).store_uint(0xd53276db,32).store_uint(q,64).end_cell(),128 + 2);
}
() recv_internal(int balance,int value,cell full,slice body) impure {
    if(body.slice_empty?()) { return (); } slice h = full.begin_parse();int flags = h~load_uint(4);if(flags & 1) { return (); } slice sender = h~load_msg_addr();
    int op = body~load_uint(32);int q = body~load_uint(64);throw_unless(407,value >= 40000000);
    (cell cfg,cell permits) = config();slice c = cfg.begin_parse();int root = c~load_uint(64);int key = c~load_uint(256);c~load_uint(256);c~load_uint(256);slice parties = c~load_ref().begin_parse();slice curve = parties~load_msg_addr();slice migrator = parties~load_msg_addr();
    if(op == 0x414e5b20) {
        throw_unless(401,equal_slices(sender,curve));throw_unless(409,(q == root) & (migrator.preload_uint(2) == 0));parties~load_msg_addr();cell expected = parties~load_ref();parties.end_parse();
        cell init = body~load_ref();body.end_parse();throw_unless(408,cell_hash(vn_migration_template(init,curve,my_address())) == cell_hash(expected));
        slice address = begin_cell().store_uint(4,3).store_int(0,8).store_uint(cell_hash(init),256).end_cell().begin_parse();
        cell binding = begin_cell().store_slice(address).store_uint(cell_hash(init),256).end_cell();cell previous = migration_binding();
        ifnot(cell_null?(previous)) { throw_unless(409,cell_hash(previous) == cell_hash(binding)); }
        else { set_data(begin_cell().store_uint(1,8).store_ref(cfg).store_dict(permits).store_dict(binding).end_cell()); }
        refund(sender,balance - value,q);return ();
    }
    throw_unless(408,migrator.preload_uint(2) == 0);cell bound = migration_binding();throw_if(409,cell_null?(bound));slice binding_slice = bound.begin_parse();migrator = binding_slice~load_msg_addr();
    if(op == 0x414e5b10) {
        cell permit = body~load_ref();slice signature = body~load_ref().begin_parse();body.end_parse();throw_unless(408,(signature.slice_bits() == 512) & (signature.slice_refs() == 0));
        (int phase,int id,int nonce,_,_,_,_,_,_,_) = validate(permit,cfg,-1);throw_unless(409,q == id);
        throw_unless(401,check_signature(cell_hash(permit),signature,key));
        (slice old,int found) = permits.udict_get?(8,phase);
        if(found) {
            int consumed = old~load_uint(2);cell prior = old~load_ref();old.end_parse();
            if(cell_hash(prior) == cell_hash(permit)) { refund(sender,balance - value,q);return (); }
            slice p = prior.begin_parse();p~skip_bits(144);int revision = p~load_uint(64);p~load_uint(32);int expiry = p~load_uint(32);
            throw_unless(409,((consumed == 0) | (consumed == 2)) & (now() >= expiry) & (nonce == revision + 1));
        } else { throw_unless(409,nonce == 1); }
        permits~udict_set_builder(8,phase,begin_cell().store_uint(0,2).store_ref(permit));save(cfg,permits);refund(sender,balance - value,q);return ();
    }
    if((op == 0x414e5b04) | (op == 0x414e5b05)) {
        int phase = (op == 0x414e5b05) ? 1 : 2;throw_unless(401,equal_slices(sender,phase == 1 ? curve : migrator));throw_unless(409,q == root);
        int nonce = body~load_uint(64);int digest = body~load_uint(256);cell snapshot = body~load_ref();body.end_parse();
        (slice r,int found) = permits.udict_get?(8,phase);throw_unless(409,found);r~load_uint(2);cell p = r~load_ref();
        (_,_,int n,int deadline,int ton,int tokens,_,int ce,int fe,int de) = validate(p,cfg,0);
        throw_unless(409,(nonce == n) & (digest == cell_hash(p)) & (now() >= deadline));slice s = snapshot.begin_parse();
        throw_unless(409,(s~load_coins() == ton) & (s~load_coins() == tokens) & (s~load_uint(64) == ce) & (s~load_uint(64) == fe) & (s~load_uint(64) == de));s.end_parse();
        ;; Only the pinned caller's versioned code may report a safe phase. It
        ;; must persist revocation locally and reject any already-sent phase.
        permits~udict_set_builder(8,phase,begin_cell().store_uint(2,2).store_ref(p));save(cfg,permits);refund(sender,balance - value,q);return ();
    }
    int phase = (op == 0x414e5701) ? 1 : 2;
    throw_unless(404,(op == 0x414e5701) | (op == 0x414e5b01));throw_unless(401,equal_slices(sender,phase == 1 ? curve : migrator));throw_unless(409,q == root);
    int requested = body~load_uint(64);int digest = body~load_uint(256);cell snapshot = body~load_ref();body.end_parse();
    (slice record,int found) = permits.udict_get?(8,phase);throw_unless(409,found);throw_unless(409,record~load_uint(2) < 2);cell permit = record~load_ref();
    (_,_,int nonce,int deadline,int ton,int tokens,_,int ce,int fe,int de) = validate(permit,cfg,-1);
    throw_unless(409,(nonce == requested) & (cell_hash(permit) == digest));slice s = snapshot.begin_parse();
    throw_unless(409,(s~load_coins() == ton) & (s~load_coins() == tokens) & (s~load_uint(64) == ce) & (s~load_uint(64) == fe) & (s~load_uint(64) == de));s.end_parse();
    permits~udict_set_builder(8,phase,begin_cell().store_uint(1,2).store_ref(permit));save(cfg,permits);
    ;; Identical funded queries re-emit the same bound grant; receivers must
    ;; persist/consume its digest before dispatch. No assets are sent here.
    raw_reserve(balance - value,0);
    cell reply = begin_cell().store_uint(phase == 1 ? 0x414e5b02 : 0x414e5b03,32).store_uint(q,64).store_uint(nonce,64).store_uint(deadline,32).store_uint(cell_hash(permit),256).store_ref(permit).end_cell();
    send_raw_message(begin_cell().store_uint(0x10,6).store_slice(sender).store_coins(0).store_uint(1,107).store_ref(reply).end_cell(),128 + 2);
}
(int,int,int,int,int) get_permit_vnext(int phase) method_id {
    (_,cell permits) = config();(slice r,int found) = permits.udict_get?(8,phase);ifnot(found) { return(0,0,0,0,0); }
    int consumed = r~load_uint(2);slice p = r~load_ref().begin_parse();p~skip_bits(144);int nonce = p~load_uint(64);p~load_uint(32);int deadline = p~load_uint(32);return(1,nonce,consumed,deadline,0);
}
int verify_signature_vnext(cell permit,slice signature) method_id {
    (cell cfg,_) = config();slice c = cfg.begin_parse();c~load_uint(64);return check_signature(cell_hash(permit),signature,c~load_uint(256));
}
(int,int,int) get_protocol_vnext() method_id { return(1,1,0); } ;; generation, permit protocol, financial execution
(slice,int) get_binding_vnext() method_id {
    cell bound = migration_binding();if(cell_null?(bound)) { return(begin_cell().store_uint(0,2).end_cell().begin_parse(),0); }
    slice s = bound.begin_parse();return(s~load_msg_addr(),s~load_uint(256));
}
