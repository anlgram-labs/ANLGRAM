// ═══════════════════════════════════════════════════════════════════════════
// ANLGRAM Staking Router TL-B Schema (Single Verified Pool: Tonstakers liquidTF)
// ═══════════════════════════════════════════════════════════════════════════

// 1. Client deposit via router (Phase 1):
// Router computes fee_nano = (principal_nano * 35) / 10000 on-chain,
// escrows fee_nano in pending_deposits[query_id] (status=0: PENDING_POOL),
// and forwards principal_nano + 1.0 TON gas to Tonstakers Pool (0x47d54391, bounce=true).
router_stake#414e4c53 query_id:uint64 principal_nano:Coins expected_network_id:int16 = InternalMsgBody;

// 2. Refund notification sent to user ONLY on:
//    Authenticated bounce of 0x47d54391 from pool_address (status=0).
stake_refunded#414e4c52 query_id:uint64 principal_nano:Coins fee_nano:Coins = InternalMsgBody;

// 3. Non-custodial retry of tsTON delivery:
//    - When status == 2 (TSTON_BOUNCED): re-sends 0x0f8a7ea5 for the verified recorded
//      jetton_amount strictly to the original depositor (user_address).
//    - Rejects if status != 2. Does NOT accept user-supplied amounts.
retry_tston_delivery#414e4c55 query_id:uint64 = InternalMsgBody;

// 4. Unilateral wall-clock timeout refund (STRICTLY DISABLED -> always throws exit_code 311):
reclaim_timeout#414e4c54 query_id:uint64 = InternalMsgBody;

// 5. Tonstakers Pool Deposit (outgoing from Router to Pool):
tonstakers_deposit#47d54391 query_id:uint64 partner_code:uint64 = InternalMsgBody;

// 6. TEP-74 Jetton Transfer Notification (incoming from Router's tsTON Jetton Wallet):
//    Strict 1-to-1 match against pending_deposits[query_id] (status=0). Zero FIFO fallback.
//    Transitions pending_deposits[query_id] to status=1 (DELIVERING_TSTON)
//    or status=2 (if insufficient gas) and sends 0x0f8a7ea5 to router_jwallet_address.
//    Does NOT mark completed or pay fee_nano yet!
transfer_notification#7362d09c query_id:uint64 amount:Coins sender:MsgAddress forward_payload:(Either Cell ^Cell) = InternalMsgBody;

// 7. TEP-74 Jetton Transfer (outgoing from Router to Router's tsTON Jetton Wallet):
//    response_destination is set to Router address so user_jwallet_address sends
//    excesses#d53276db back to Router ONLY AFTER crediting tsTON to user_address.
jetton_transfer#0f8a7ea5 query_id:uint64 amount:Coins destination:MsgAddress response_destination:MsgAddress custom_payload:(Maybe ^Cell) forward_ton_amount:Coins forward_payload:(Either Cell ^Cell) = InternalMsgBody;

// 8. TEP-74 Excesses (incoming/outgoing gas refund & client delivery confirmation):
//    - From pool_address / router_jwallet_address: forwards unused pool gas to user_address.
//    - From user_jwallet_address (when status == 1): confirms client received tsTON,
//      moves query_id to completed_deposits, releases 0.35% fee_nano to fee_recipient,
//      and forwards excess gas to user_address.
excesses#d53276db query_id:uint64 = InternalMsgBody;

// 9. Admin configuration (cannot touch user principal, pending escrow, or tsTON):
set_router_jwallet#414e4c60 query_id:uint64 jwallet_address:MsgAddress = InternalMsgBody;
set_paused#414e4c61 query_id:uint64 paused:uint1 = InternalMsgBody;

// 10. PendingDeposit Dictionary Entry (64-bit key = query_id):
//     status: 0 = PENDING_POOL, 1 = DELIVERING_TSTON, 2 = TSTON_BOUNCED
pending_deposit$_ user_address:MsgAddressInt principal_nano:Coins fee_nano:Coins extra_gas:Coins jetton_amount:Coins created_at:uint64 status:uint8 = PendingDeposit;
