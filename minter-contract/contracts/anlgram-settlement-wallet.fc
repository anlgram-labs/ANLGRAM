;; ANLGRAM settlement wallet v1. Opt-in code; canonical standard wallet is unchanged.

#include "imports/stdlib.fc";
#include "imports/params.fc";
#include "imports/constants.fc";
#include "imports/jetton-utils.fc";
#include "imports/op-codes.fc";
#include "imports/utils.fc";
#pragma version >=0.2.0;
#include "imports/settlement-protocol.fc";

{-

NOTE that this tokens can be transferred within the same workchain.

This is suitable for most tokens, if you need tokens transferable between workchains there are two solutions:

1) use more expensive but universal function to calculate message forward fee for arbitrary destination (see `misc/forward-fee-calc.cs`)

2) use token holder proxies in target workchain (that way even 'non-universal' token can be used from any workchain)

-}

const min_tons_for_storage = 10000000; ;; 0.01 TON
const gas_consumption = 10000000; ;; 0.01 TON

{-
  Storage
  storage#_ balance:Coins owner_address:MsgAddressInt jetton_master_address:MsgAddressInt jetton_wallet_code:^Cell = Storage;
-}

(int, slice, slice, cell) load_data() inline {
  slice ds = get_data().begin_parse();
  return (ds~load_coins(), ds~load_msg_addr(), ds~load_msg_addr(), ds~load_ref());
}

cell settlement_records() inline {
  slice ds = get_data().begin_parse();
  ds~load_coins(); ds~load_msg_addr(); ds~load_msg_addr(); ds~load_ref();
  return ds.slice_bits() ? ds~load_dict() : null();
}

() save_with_records(int balance, slice owner, slice master, cell code, cell records) impure inline {
  builder b = begin_cell().store_coins(balance).store_slice(owner).store_slice(master).store_ref(code);
  ;; Empty initial state retains the standard wallet data shape; code differs.
  ifnot (cell_null?(records)) { b = b.store_dict(records); }
  set_data(b.end_cell());
}

() save_data(int balance, slice owner, slice master, cell code) impure inline {
  save_with_records(balance, owner, master, code, settlement_records());
}

int record_key(int kind, int id) inline {
  return cell_hash(begin_cell().store_uint(kind, 32).store_uint(id, 64).end_cell());
}
int incoming_key(slice peer, int id) inline {
  return cell_hash(begin_cell().store_uint(0x494e434d, 32).store_slice(peer).store_uint(id, 64).end_cell());
}
() send_remaining(slice recipient, cell body, int previous_balance, int bounce) impure inline {
  raw_reserve(previous_balance, 0);
  send_raw_message(begin_cell().store_uint(bounce ? 0x18 : 0x10, 6).store_slice(recipient).store_coins(0)
    .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1).store_ref(body).end_cell(), 128);
}
() receipt_remaining(slice recipient, cell body, int previous_balance) impure inline {
  ;; Receipt delivery is retryable. An unfunded outgoing action must NEVER
  ;; roll back already restored/credited Jettons or the authoritative ledger.
  raw_reserve(max(previous_balance,10000000),2);
  send_raw_message(begin_cell().store_uint(0x10,6).store_slice(recipient).store_coins(0)
    .store_uint(1,1 + 4 + 4 + 64 + 32 + 1 + 1).store_ref(body).end_cell(),128 + 2);
}
() owner_receipt(slice owner, int owner_id, int wire_id, int amount, int status, int previous_balance) impure inline {
  receipt_remaining(owner, begin_cell().store_uint(sop::receipt,32).store_uint(owner_id,64)
    .store_uint(wire_id,64).store_coins(amount).store_uint(status,2).end_cell(), previous_balance);
}

() settled_send(slice body, slice sender, int value, int fwd_fee, int ton_balance) impure {
  int owner_id = body~load_uint(64);
  int amount = body~load_coins();
  slice destination = body~load_msg_addr(); force_chain(destination);
  slice response = body~load_msg_addr(); body~load_dict();
  int forward = body~load_coins(); throw_unless(708, body.slice_bits() >= 1);
  if (body.preload_uint(1)) { throw_unless(708,(body.slice_bits() == 1) & (body.slice_refs() == 1)); }
  (int balance, slice owner, slice master, cell code) = load_data();
  throw_unless(705, equal_slices(sender, owner));
  throw_unless(708, equal_slices(response, owner));
  cell records = settlement_records();
  (slice index, int duplicate) = records.udict_get?(256, record_key(0x4f574e51,owner_id));
  if (duplicate) {
    int wire_id = index~load_uint(64);
    (slice record,_) = records.udict_get?(256,record_key(0x4f555447,wire_id));
    int status = record~load_uint(2); record~load_uint(64);
    int expected = record~load_coins(); slice peer = record~load_msg_addr();
    throw_unless(708,(amount == expected) & equal_slices(peer,calculate_user_jetton_wallet_address(destination,master,code)));
    ;; Repeated owner requests never resend tokens and never generate a failure
    ;; bounce for the identical request. Pending operations query their peer.
    if (status != 1) { owner_receipt(owner,owner_id,wire_id,amount,status,ton_balance - value); }
    else { send_remaining(peer,begin_cell().store_uint(sop::query,32).store_uint(wire_id,64).end_cell(),ton_balance - value,1); }
    return ();
  }
  throw_unless(706,(amount > 0) & (balance >= amount));
  throw_unless(709, value > forward + (forward ? 2 : 1) * fwd_fee + 30000000);
  int wire_id = cur_lt();
  cell init = calculate_jetton_wallet_state_init(destination, master, code);
  slice peer = calculate_jetton_wallet_address(init);
  records~udict_set_builder(256, record_key(0x4f574e51,owner_id), begin_cell().store_uint(wire_id,64));
  records~udict_set_builder(256, record_key(0x4f555447,wire_id), begin_cell().store_uint(1,2).store_uint(owner_id,64).store_coins(amount).store_slice(peer));
  save_with_records(balance - amount,owner,master,code,records);
  cell payload = begin_cell().store_uint(sop::internal,32).store_uint(wire_id,64).store_coins(amount)
    .store_slice(owner).store_coins(forward).store_slice(body).end_cell();
  raw_reserve(max(ton_balance - value,10000000),0);
  send_raw_message(begin_cell().store_uint(0x18,6).store_slice(peer).store_coins(0)
    .store_uint(7,1 + 4 + 4 + 64 + 32 + 1 + 1 + 1).store_ref(init).store_ref(payload).end_cell(),128);
}

() settled_receive(slice body, slice sender, int value, int ton_balance, int fwd_fee) impure {
  int wire_id = body~load_uint(64); int amount = body~load_coins();
  slice from = body~load_msg_addr(); int forward = body~load_coins();
  throw_unless(708, body.slice_bits() >= 1);
  if (body.preload_uint(1)) { throw_unless(708,(body.slice_bits() == 1) & (body.slice_refs() == 1)); }
  (int balance, slice owner, slice master, cell code) = load_data();
  throw_unless(707, equal_slices(sender,calculate_user_jetton_wallet_address(from,master,code)));
  throw_unless(706, amount > 0);
  throw_unless(709,value > forward + max(10000000 - (ton_balance - value),0) + gas_consumption + 2 * fwd_fee);
  cell records = settlement_records(); int key = incoming_key(sender,wire_id);
  (slice prior, int duplicate) = records.udict_get?(256,key);
  if (duplicate) { throw_unless(708, prior~load_coins() == amount); }
  else {
    records~udict_set_builder(256,key,begin_cell().store_coins(amount));
    save_with_records(balance + amount,owner,master,code,records);
    if (forward) {
      cell notification = begin_cell().store_uint(op::transfer_notification(),32).store_uint(wire_id,64)
        .store_coins(amount).store_slice(from).store_slice(body).end_cell();
      send_raw_message(begin_cell().store_uint(0x10,6).store_slice(owner).store_coins(forward)
        .store_uint(1,1 + 4 + 4 + 64 + 32 + 1 + 1).store_ref(notification).end_cell(),1 + 2);
    }
  }
  ;; Ack/owner notification failures are not failed token delivery. Preserve
  ;; credited ownership and its record; a funded query can regenerate the ack.
  receipt_remaining(sender,begin_cell().store_uint(sop::ack,32).store_uint(wire_id,64).store_coins(amount).end_cell(),ton_balance - value);
}

() settled_outcome(slice body, slice sender, int value, int ton_balance, int failed) impure {
  int wire_id = body~load_uint(64); int amount = body~load_coins();
  ifnot(failed) { body.end_parse(); }
  cell records = settlement_records(); int key = record_key(0x4f555447,wire_id);
  (slice record, int found) = records.udict_get?(256,key);
  throw_unless(711, found);
  int status = record~load_uint(2); int owner_id = record~load_uint(64);
  int expected = record~load_coins(); slice peer = record~load_msg_addr();
  throw_unless(707, equal_slices(sender,peer)); throw_unless(708, amount == expected);
  if (status != 1) { return (); }
  (int balance, slice owner, slice master, cell code) = load_data();
  status = failed ? 3 : 2;
  records~udict_set_builder(256,key,begin_cell().store_uint(status,2).store_uint(owner_id,64).store_coins(amount).store_slice(peer));
  save_with_records(balance + (failed ? amount : 0),owner,master,code,records);
  owner_receipt(owner,owner_id,wire_id,amount,status,ton_balance - value);
}

() settled_retry(slice body, int value, int ton_balance, int receipt_only) impure {
  throw_unless(709, value >= 10000000);
  int owner_id = body~load_uint(64); body.end_parse();
  cell records = settlement_records();
  (slice index, int found) = records.udict_get?(256,record_key(0x4f574e51,owner_id));
  ifnot(found) {
    (_,slice owner,_,_) = load_data();
    ;; Absence is NOT failure. Owner may resubmit the SAME operation id; the
    ;; persistent owner-id guard makes either message ordering exactly once.
    send_remaining(owner,begin_cell().store_uint(sop::not_seen,32).store_uint(owner_id,64).end_cell(),ton_balance - value,0);
    return ();
  }
  int wire_id = index~load_uint(64);
  (slice record, _) = records.udict_get?(256,record_key(0x4f555447,wire_id));
  int status = record~load_uint(2); record~load_uint(64); int amount = record~load_coins(); slice peer = record~load_msg_addr();
  (_, slice owner, _, _) = load_data();
  if (status != 1) { owner_receipt(owner,owner_id,wire_id,amount,status,ton_balance - value); }
  else {
    ;; Query only: NEVER resend the tokens after an uncertain delivery.
    send_remaining(peer,begin_cell().store_uint(sop::query,32).store_uint(wire_id,64).end_cell(),ton_balance - value,1);
  }
}

() settled_query(slice body, slice sender, int value, int ton_balance) impure {
  int wire_id = body~load_uint(64); body.end_parse();
  (slice record, int found) = settlement_records().udict_get?(256,incoming_key(sender,wire_id));
  throw_unless(711,found);
  int amount = record~load_coins();
  send_remaining(sender,begin_cell().store_uint(sop::ack,32).store_uint(wire_id,64).store_coins(amount).end_cell(),ton_balance - value,0);
}

{-
  transfer query_id:uint64 amount:(VarUInteger 16) destination:MsgAddress
           response_destination:MsgAddress custom_payload:(Maybe ^Cell)
           forward_ton_amount:(VarUInteger 16) forward_payload:(Either Cell ^Cell)
           = InternalMsgBody;
  internal_transfer  query_id:uint64 amount:(VarUInteger 16) from:MsgAddress
                     response_address:MsgAddress
                     forward_ton_amount:(VarUInteger 16)
                     forward_payload:(Either Cell ^Cell)
                     = InternalMsgBody;
-}

() send_tokens (slice in_msg_body, slice sender_address, int msg_value, int fwd_fee) impure {
  int query_id = in_msg_body~load_uint(64);
  int jetton_amount = in_msg_body~load_coins();
  slice to_owner_address = in_msg_body~load_msg_addr();
  force_chain(to_owner_address);
  (int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) = load_data();
  balance -= jetton_amount;

  throw_unless(705, equal_slices(owner_address, sender_address));
  throw_unless(706, balance >= 0);

  cell state_init = calculate_jetton_wallet_state_init(to_owner_address, jetton_master_address, jetton_wallet_code);
  slice to_wallet_address = calculate_jetton_wallet_address(state_init);
  slice response_address = in_msg_body~load_msg_addr();
  cell custom_payload = in_msg_body~load_dict();
  int forward_ton_amount = in_msg_body~load_coins();
  throw_unless(708, slice_bits(in_msg_body) >= 1);
  slice either_forward_payload = in_msg_body;
  var msg = begin_cell()
    .store_uint(0x18, 6)
    .store_slice(to_wallet_address)
    .store_coins(0)
    .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
    .store_ref(state_init);
  var msg_body = begin_cell()
    .store_uint(op::internal_transfer(), 32)
    .store_uint(query_id, 64)
    .store_coins(jetton_amount)
    .store_slice(owner_address)
    .store_slice(response_address)
    .store_coins(forward_ton_amount)
    .store_slice(either_forward_payload)
    .end_cell();

  msg = msg.store_ref(msg_body);
  int fwd_count = forward_ton_amount ? 2 : 1;
  throw_unless(709, msg_value >
                     forward_ton_amount +
                     ;; 3 messages: wal1->wal2,  wal2->owner, wal2->response
                     ;; but last one is optional (it is ok if it fails)
                     fwd_count * fwd_fee +
                     (2 * gas_consumption + min_tons_for_storage));
                     ;; universal message send fee calculation may be activated here
                     ;; by using this instead of fwd_fee
                     ;; msg_fwd_fee(to_wallet, msg_body, state_init, 15)

  send_raw_message(msg.end_cell(), 64); ;; revert on errors
  save_data(balance, owner_address, jetton_master_address, jetton_wallet_code);
}

{-
  internal_transfer  query_id:uint64 amount:(VarUInteger 16) from:MsgAddress
                     response_address:MsgAddress
                     forward_ton_amount:(VarUInteger 16)
                     forward_payload:(Either Cell ^Cell)
                     = InternalMsgBody;
-}

() receive_tokens (slice in_msg_body, slice sender_address, int my_ton_balance, int fwd_fee, int msg_value) impure {
  ;; NOTE we can not allow fails in action phase since in that case there will be
  ;; no bounce. Thus check and throw in computation phase.
  (int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) = load_data();
  int query_id = in_msg_body~load_uint(64);
  int jetton_amount = in_msg_body~load_coins();
  balance += jetton_amount;
  slice from_address = in_msg_body~load_msg_addr();
  slice response_address = in_msg_body~load_msg_addr();
  throw_unless(707,
      equal_slices(jetton_master_address, sender_address)
      |
      equal_slices(calculate_user_jetton_wallet_address(from_address, jetton_master_address, jetton_wallet_code), sender_address)
  );
  int forward_ton_amount = in_msg_body~load_coins();

  int ton_balance_before_msg = my_ton_balance - msg_value;
  int storage_fee = min_tons_for_storage - min(ton_balance_before_msg, min_tons_for_storage);
  msg_value -= (storage_fee + gas_consumption);
  if(forward_ton_amount) {
    msg_value -= (forward_ton_amount + fwd_fee);
    slice either_forward_payload = in_msg_body;

    var msg_body = begin_cell()
        .store_uint(op::transfer_notification(), 32)
        .store_uint(query_id, 64)
        .store_coins(jetton_amount)
        .store_slice(from_address)
        .store_slice(either_forward_payload)
        .end_cell();

    var msg = begin_cell()
      .store_uint(0x10, 6) ;; we should not bounce here cause receiver can have uninitialized contract
      .store_slice(owner_address)
      .store_coins(forward_ton_amount)
      .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
      .store_ref(msg_body);

    send_raw_message(msg.end_cell(), 1);
  }

  if ((response_address.preload_uint(2) != 0) & (msg_value > 0)) {
    var msg = begin_cell()
      .store_uint(0x10, 6) ;; nobounce - int_msg_info$0 ihr_disabled:Bool bounce:Bool bounced:Bool src:MsgAddress -> 010000
      .store_slice(response_address)
      .store_coins(msg_value)
      .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
      .store_uint(op::excesses(), 32)
      .store_uint(query_id, 64);
    send_raw_message(msg.end_cell(), 2);
  }

  save_data(balance, owner_address, jetton_master_address, jetton_wallet_code);
}

() burn_tokens (slice in_msg_body, slice sender_address, int msg_value, int fwd_fee) impure {
  ;; NOTE we can not allow fails in action phase since in that case there will be
  ;; no bounce. Thus check and throw in computation phase.
  (int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) = load_data();
  int query_id = in_msg_body~load_uint(64);
  int jetton_amount = in_msg_body~load_coins();
  slice response_address = in_msg_body~load_msg_addr();
  ;; ignore custom payload
  ;; slice custom_payload = in_msg_body~load_dict();
  balance -= jetton_amount;
  throw_unless(705, equal_slices(owner_address, sender_address));
  throw_unless(706, balance >= 0);
  throw_unless(707, msg_value > fwd_fee + 2 * gas_consumption);

  var msg_body = begin_cell()
      .store_uint(op::burn_notification(), 32)
      .store_uint(query_id, 64)
      .store_coins(jetton_amount)
      .store_slice(owner_address)
      .store_slice(response_address)
      .end_cell();

  var msg = begin_cell()
    .store_uint(0x18, 6)
    .store_slice(jetton_master_address)
    .store_coins(0)
    .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
    .store_ref(msg_body);

  send_raw_message(msg.end_cell(), 64);

  save_data(balance, owner_address, jetton_master_address, jetton_wallet_code);
}

() on_bounce (slice in_msg_body) impure {
  in_msg_body~skip_bits(32); ;; 0xFFFFFFFF
  (int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) = load_data();
  int op = in_msg_body~load_uint(32);
  throw_unless(709, (op == op::internal_transfer()) | (op == op::burn_notification()));
  int query_id = in_msg_body~load_uint(64);
  int jetton_amount = in_msg_body~load_coins();
  balance += jetton_amount;
  save_data(balance, owner_address, jetton_master_address, jetton_wallet_code);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  if (in_msg_body.slice_empty?()) { ;; ignore empty messages
    return ();
  }

  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);
  slice sender_address = cs~load_msg_addr();
  if (flags & 1) {
    slice bounced = in_msg_body;
    if (bounced.slice_bits() >= 64) {
      bounced~skip_bits(32); int original = bounced~load_uint(32);
      if (original == sop::internal) { settled_outcome(bounced,sender_address,msg_value,my_balance,1); return (); }
      if (original == sop::query) { return (); }
    }
    on_bounce(in_msg_body);
    return ();
  }
  cs~load_msg_addr(); ;; skip dst
  cs~load_coins(); ;; skip value
  cs~skip_bits(1); ;; skip extracurrency collection
  cs~load_coins(); ;; skip ihr_fee
  int fwd_fee = muldiv(cs~load_coins(), 3, 2); ;; we use message fwd_fee for estimation of forward_payload costs

  int op = in_msg_body~load_uint(32);

  if (op == sop::transfer) { settled_send(in_msg_body,sender_address,msg_value,fwd_fee,my_balance); return (); }
  if (op == sop::internal) { settled_receive(in_msg_body,sender_address,msg_value,my_balance,fwd_fee); return (); }
  if (op == sop::ack) { settled_outcome(in_msg_body,sender_address,msg_value,my_balance,0); return (); }
  if (op == sop::retry) { settled_retry(in_msg_body,msg_value,my_balance,0); return (); }
  if (op == sop::query) { settled_query(in_msg_body,sender_address,msg_value,my_balance); return (); }

  if (op == op::transfer()) { ;; outgoing transfer
    send_tokens(in_msg_body, sender_address, msg_value, fwd_fee);
    return ();
  }

  if (op == op::internal_transfer()) { ;; incoming transfer
    receive_tokens(in_msg_body, sender_address, my_balance, fwd_fee, msg_value);
    return ();
  }

  if (op == op::burn()) { ;; burn
    burn_tokens(in_msg_body, sender_address, msg_value, fwd_fee);
    return ();
  }

  throw(0xffff);
}

(int, slice, slice, cell) get_wallet_data() method_id {
  return load_data();
}

(int, int, int) get_settlement(int owner_id) method_id {
  cell records = settlement_records();
  (slice index,int found) = records.udict_get?(256,record_key(0x4f574e51,owner_id));
  ifnot(found) { return (0,0,0); }
  int wire_id = index~load_uint(64);
  (slice record,_) = records.udict_get?(256,record_key(0x4f555447,wire_id));
  int status = record~load_uint(2); record~load_uint(64); int amount = record~load_coins();
  return (status,wire_id,amount);
}
