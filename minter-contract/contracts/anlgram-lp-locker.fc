;; ANLGRAM Launchpad — Immutable DEX LP Locker Smart Contract (Remediated)
;; File: minter-contract/contracts/anlgram-lp-locker.fc
;; 
;; Features:
;; 1. Holds DEX Liquidity Provider (LP) Jettons indefinitely.
;; 2. Rejects ANY withdrawal, burn, or transfer attempt before unlock_timestamp.
;; 3. Permanent Lock Mode (unlock_timestamp = 0xFFFFFFFFFFFFFFFF) eliminates any withdrawal path.
;; 4. Anti-Front-Running Security:
;;    - Dynamic first-transfer binding is REMOVED.
;;    - Configuration requires authorized one-time initialization via op::set_lp_wallet (0x414e4c31).
;;    - All transfers before initialization are strictly REJECTED (exit code 406).
;;    - Transfers from any address other than the verified lp_wallet_address are strictly REJECTED (exit code 401).
;; 5. Upon receipt of valid LP tokens, emits on-chain confirmation (op::lp_locked_confirmation = 0x414e4c33)
;;    to the authorized curve/router for trustless graduation verification.
;; 6. Exposes get_lock_data(), is_permanently_locked(), and get_locked_lp_amount() for public inspection.

#include "imports/stdlib.fc";
#include "imports/params.fc";
#include "imports/constants.fc";
#include "imports/op-codes.fc";
#include "imports/utils.fc";
#pragma version >=0.2.0;

const int ERROR_UNAUTHORIZED_SENDER = 401;
const int ERROR_LOCK_ACTIVE         = 403;
const int ERROR_UNKNOWN_OP          = 404;
const int ERROR_ALREADY_INITIALIZED = 405;
const int ERROR_NOT_INITIALIZED     = 406;

const int op::set_lp_wallet          = 0x414e4c31;
const int op::withdraw_lp            = 0x414e4c32;
const int op::lp_locked_confirmation = 0x414e4c33;

;; Storage Layout:
;; is_locked:uint1
;; unlock_timestamp:uint64 (0xFFFFFFFFFFFFFFFF for permanent)
;; lp_amount_locked:Coins
;; is_wallet_initialized:uint1
;; pool_address:MsgAddress
;; expected_lp_minter:MsgAddress
;; lp_wallet_address:MsgAddress
;; authorized_caller:MsgAddress

(int, int, int, int, slice, slice, slice, slice) load_data() inline {
    slice ds = get_data().begin_parse();
    int is_locked = ds~load_uint(1);
    int unlock_timestamp = ds~load_uint(64);
    int lp_amount_locked = ds~load_coins();
    int is_wallet_initialized = ds~load_uint(1);
    slice pool_address = ds~load_msg_addr();
    slice expected_lp_minter = ds~load_msg_addr();

    cell c2 = ds~load_ref();
    slice s2 = c2.begin_parse();
    slice lp_wallet_address = s2~load_msg_addr();
    slice authorized_caller = s2~load_msg_addr();

    return (
        is_locked, unlock_timestamp, lp_amount_locked, is_wallet_initialized,
        pool_address, expected_lp_minter, lp_wallet_address, authorized_caller
    );
}

() save_data(int is_locked, int unlock_timestamp, int lp_amount_locked, int is_wallet_initialized, slice pool_address, slice expected_lp_minter, slice lp_wallet_address, slice authorized_caller) impure inline {
    set_data(begin_cell()
        .store_uint(is_locked, 1)
        .store_uint(unlock_timestamp, 64)
        .store_coins(lp_amount_locked)
        .store_uint(is_wallet_initialized, 1)
        .store_slice(pool_address)
        .store_slice(expected_lp_minter)
        .store_ref(
            begin_cell()
                .store_slice(lp_wallet_address)
                .store_slice(authorized_caller)
                .end_cell()
        )
        .end_cell()
    );
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return (); ;; Accept pure TON donations to pay for TVM storage rent
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return (); ;; Ignore bounced messages
    }
    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (
        int is_locked, int unlock_timestamp, int lp_amount_locked, int is_wallet_initialized,
        slice pool_address, slice expected_lp_minter, slice lp_wallet_address, slice authorized_caller
    ) = load_data();

    ;; ------------------------------------------------------------------------
    ;; 1. OP::SET_LP_WALLET (One-Time Authorized Configuration)
    ;; ------------------------------------------------------------------------
    if (op == op::set_lp_wallet) {
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, authorized_caller));
        throw_if(ERROR_ALREADY_INITIALIZED, is_wallet_initialized == 1);

        slice new_lp_wallet = in_msg_body~load_msg_addr();
        lp_wallet_address = new_lp_wallet;
        is_wallet_initialized = 1;

        save_data(is_locked, unlock_timestamp, lp_amount_locked, is_wallet_initialized, pool_address, expected_lp_minter, lp_wallet_address, authorized_caller);
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 2. OP::TRANSFER_NOTIFICATION (Inbound Official LP Tokens)
    ;; ------------------------------------------------------------------------
    if (op == op::transfer_notification()) {
        ;; Anti-Front-Running Gate 1: Must be initialized
        throw_unless(ERROR_NOT_INITIALIZED, is_wallet_initialized == 1);

        ;; Anti-Front-Running Gate 2: Sender MUST be the authentic configured LP Wallet
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, lp_wallet_address));

        int jetton_amount = in_msg_body~load_coins();
        slice from_address = in_msg_body~load_msg_addr();

        lp_amount_locked += jetton_amount;
        is_locked = 1;

        save_data(is_locked, unlock_timestamp, lp_amount_locked, is_wallet_initialized, pool_address, expected_lp_minter, lp_wallet_address, authorized_caller);

        ;; Emit On-Chain Confirmation to Authorized Caller (Curve)
        var confirm_body = begin_cell()
            .store_uint(op::lp_locked_confirmation, 32)
            .store_uint(query_id, 64)
            .store_coins(lp_amount_locked)
            .store_slice(pool_address)
            .end_cell();

        var confirm_msg = begin_cell()
            .store_uint(0x10, 6) ;; non-bounceable
            .store_slice(authorized_caller)
            .store_coins(10000000) ;; 0.01 TON
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(confirm_body);

        send_raw_message(confirm_msg.end_cell(), 1);

        ;; Send excesses back to response address if requested
        if (msg_value > const::min_tons_for_storage() + 20000000) {
            var msg = begin_cell()
                .store_uint(0x10, 6)
                .store_slice(from_address)
                .store_coins(0)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_uint(op::excesses(), 32)
                .store_uint(query_id, 64);
            send_raw_message(msg.end_cell(), 64);
        }
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 3. OP::WITHDRAW_LP (Withdrawal Attempt)
    ;; ------------------------------------------------------------------------
    if (op == op::withdraw_lp) {
        ;; Permanent Lock (0xFFFFFFFFFFFFFFFF) can NEVER be satisfied
        throw_if(ERROR_LOCK_ACTIVE, unlock_timestamp == 0xFFFFFFFFFFFFFFFF);
        throw_if(ERROR_LOCK_ACTIVE, now() < unlock_timestamp);
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, authorized_caller));

        int withdraw_amount = in_msg_body~load_coins();
        throw_unless(error::insufficient_balance(), withdraw_amount <= lp_amount_locked);

        lp_amount_locked -= withdraw_amount;
        if (lp_amount_locked == 0) {
            is_locked = 0;
        }
        save_data(is_locked, unlock_timestamp, lp_amount_locked, is_wallet_initialized, pool_address, expected_lp_minter, lp_wallet_address, authorized_caller);

        var msg_body = begin_cell()
            .store_uint(op::transfer(), 32)
            .store_uint(query_id, 64)
            .store_coins(withdraw_amount)
            .store_slice(authorized_caller)
            .store_slice(authorized_caller)
            .store_uint(0, 1)
            .store_coins(10000000)
            .store_uint(0, 1)
            .end_cell();

        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(lp_wallet_address)
            .store_coins(0)
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(msg_body);

        send_raw_message(msg.end_cell(), 64);
        return ();
    }

    throw(ERROR_UNKNOWN_OP);
}

;; ----------------------------------------------------------------------------
;; GET METHODS (Read-Only Public Inspection)
;; ----------------------------------------------------------------------------

(int, int, int, int, slice, slice, slice, slice) get_lock_data() method_id {
    return load_data();
}

int is_permanently_locked() method_id {
    (int is_locked, int unlock_timestamp, _, _, _, _, _, _) = load_data();
    if ((is_locked == 1) & (unlock_timestamp == 0xFFFFFFFFFFFFFFFF)) {
        return -1; ;; true
    }
    return 0; ;; false
}

int get_locked_lp_amount() method_id {
    (_, _, int lp_amount_locked, _, _, _, _, _) = load_data();
    return lp_amount_locked;
}

int is_wallet_initialized() method_id {
    (_, _, _, int is_initialized, _, _, _, _) = load_data();
    return is_initialized;
}
