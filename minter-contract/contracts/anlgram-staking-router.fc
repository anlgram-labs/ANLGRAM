;; ═══════════════════════════════════════════════════════════════════════════
;; ANLGRAM Staking Router Contract (Non-Custodial Escrow & Fee Router)
;; File: minter-contract/contracts/anlgram-staking-router.fc
;;
;; Single Verified Pool Protocol: Tonstakers Official Liquid Staking (liquidTF)
;; Fee Policy:
;;   - ANLGRAM_STAKE_FEE_BPS = 35 (0.35% of accepted & confirmed principal)
;;   - Integer arithmetic in nanoTON: fee_nano = muldiv(principal_nano, 35, 10000)
;;   - Rounded down to nanoTON, no cap, 0% fee on withdrawals/claims.
;;   - Fee Recipient: UQDW_PsjmeOBB_fvzOFmwqW7redEcufKQgImyrURvO7dbSYd
;;
;; Asynchronous Safety, Bounce Handling & Zero-Lock Guarantees:
;;   1. Phase 1 (op::router_stake 0x414e4c53):
;;      Escrows fee_nano (0.35%) in pending_deposits[query_id] with status=0
;;      (STATUS_PENDING_POOL) and forwards principal_nano + 1.00 TON to
;;      pool_address (0x47d54391, bounce=true). Zero fee is charged in Phase 1.
;;   2. Authenticated Pool Bounce (0x47d54391 from pool_address):
;;      Moves query_id from pending_deposits (status=0) to refunded_deposits and
;;      refunds principal + escrowed fee + unused gas to user_address. Zero fee charged.
;;   3. Phase 2a (op::transfer_notification 0x7362d09c from router_jwallet_address):
;;      - If query_id was altered by delayed round-end minting, matches earliest
;;        FIFO deposit in status=0 so notifications are never dropped.
;;      - If msg_value / balance is insufficient to attach 0.105 TON gas to
;;        0x0f8a7ea5, sets status=2 (STATUS_TSTON_BOUNCED_OR_QUEUED) without throwing.
;;      - Otherwise sets status=1 (STATUS_DELIVERING_TSTON) and sends 0x0f8a7ea5
;;        (bounce=true, 0.105 TON + extra_gas, destination=user_address,
;;        response_destination=my_address()) to router_jwallet_address.
;;      - Does NOT mark completed and does NOT pay the 0.35% fee yet!
;;   4. Authenticated Jetton Transfer Bounce (0x0f8a7ea5 from router_jwallet_address):
;;      - If status==1 (normal delivery bounced): transitions to status=2
;;        (STATUS_TSTON_BOUNCED_OR_QUEUED). Zero fee is charged, deposit is NOT
;;        marked completed, and tsTON can be re-sent via 0x414e4c55.
;;      - If status==3 (recovery/probe after timeout_sec when 0x7362d09c never arrived):
;;        if jetton_amount==1 (1 nano-tsTON probe bounced, proving 0 tsTON minted
;;        in router_jwallet_address), moves query_id to refunded_deposits and
;;        refunds escrowed fee + extra_gas + bounced value to user_address.
;;   5. Phase 2b (op::excesses 0xd53276db from user_jwallet_address):
;;      - Sent by user_jwallet_address ONLY AFTER crediting tsTON to user_address.
;;      - Atomically moves query_id from pending_deposits (status=1 or 3) to
;;        completed_deposits, sends 0.35% fee_nano to fee_recipient, and forwards
;;        excess gas to user_address.
;;   6. Non-Custodial Recovery (op::retry_tston_delivery 0x414e4c55):
;;      - For status==2: re-sends 0x0f8a7ea5 for recorded jetton_amount strictly
;;        to the original user_address.
;;      - For status==0 after timeout_sec (if 0x7362d09c never arrived): allows
;;        user_address to pass claim_jetton_amount (<= principal_nano) to deliver
;;        minted tsTON from router_jwallet_address, or claim_jetton_amount=1 to
;;        cryptographically prove 0 tsTON balance and trigger refund on bounce.
;;   7. Admin has zero ability to withdraw client principal, escrowed fees, or tsTON.
;; ═══════════════════════════════════════════════════════════════════════════

#include "imports/stdlib.fc";
#pragma version >=0.2.0;

;; ── Opcodes ────────────────────────────────────────────────────────────────
int op::router_stake()          asm "0x414e4c53 PUSHINT"; ;; Client -> Router deposit
int op::stake_refunded()        asm "0x414e4c52 PUSHINT"; ;; Router -> Client bounce refund
int op::reclaim_timeout()       asm "0x414e4c54 PUSHINT"; ;; Disabled unilateral timeout (always throws 311)
int op::retry_tston_delivery()  asm "0x414e4c55 PUSHINT"; ;; Retry / recover tsTON delivery
int op::set_router_jwallet()    asm "0x414e4c60 PUSHINT"; ;; Admin -> Router set tsTON jwallet
int op::set_paused()            asm "0x414e4c61 PUSHINT"; ;; Admin -> Router pause/unpause

;; Protocol Opcodes (Tonstakers & TEP-74 Jettons)
int op::tonstakers_deposit()    asm "0x47d54391 PUSHINT"; ;; Router -> Tonstakers Pool
int op::transfer_notification() asm "0x7362d09c PUSHINT"; ;; Router tsTON JWallet -> Router
int op::jetton_transfer()       asm "0x0f8a7ea5 PUSHINT"; ;; Router -> Router tsTON JWallet
int op::excesses()              asm "0xd53276db PUSHINT"; ;; Excess gas & delivery confirmation

;; ── Pending Deposit Status Codes ───────────────────────────────────────────
int status::pending_pool()      asm "0 PUSHINT"; ;; Waiting for Pool / 0x7362d09c
int status::delivering_tston()  asm "1 PUSHINT"; ;; 0x0f8a7ea5 in flight to user_address
int status::tston_bounced()     asm "2 PUSHINT"; ;; 0x0f8a7ea5 bounced or low gas; retryable via 0x414e4c55
int status::recovery_delivery() asm "3 PUSHINT"; ;; Post-timeout recovery/probe in flight to router_jwallet

;; ── Error Codes ────────────────────────────────────────────────────────────
int error::router_paused()              asm "300 PUSHINT";
int error::access_denied()              asm "301 PUSHINT";
int error::invalid_query_id()           asm "302 PUSHINT";
int error::wrong_network()              asm "303 PUSHINT";
int error::jwallet_not_configured()     asm "304 PUSHINT";
int error::below_min_stake()            asm "305 PUSHINT";
int error::duplicate_query_id()         asm "306 PUSHINT";
int error::insufficient_msg_value()     asm "307 PUSHINT";
int error::unauthorized_jwallet()       asm "308 PUSHINT";
int error::unknown_pending_deposit()    asm "309 PUSHINT";
int error::zero_minted_jettons()        asm "310 PUSHINT";
int error::timeout_refund_disabled()    asm "311 PUSHINT";
int error::invalid_fee_bps()            asm "312 PUSHINT";
int error::jwallet_locked()             asm "313 PUSHINT";
int error::no_bounced_tston()           asm "314 PUSHINT";
int error::unknown_op()                 asm "399 PUSHINT";

;; ── Constants (nanoTON) ────────────────────────────────────────────────────
int const::fee_bps_exact()          asm "35 PUSHINT";         ;; 35 bps = 0.35% (NEVER 3500)
int const::bps_denominator()        asm "10000 PUSHINT";      ;; 10,000 bps = 100%
int const::pool_deposit_gas()       asm "1000000000 PUSHINT"; ;; 1.00 TON attached to Tonstakers Pool
int const::router_processing_gas()  asm "150000000 PUSHINT";  ;; 0.15 TON for router + jetton forward + fee send
int const::jetton_transfer_gas()    asm "105000000 PUSHINT";  ;; 0.105 TON attached to 0x0f8a7ea5 (~2x TEP-74 min)
int const::jetton_notify_gas()      asm "15000000 PUSHINT";   ;; 0.015 TON forward_ton_amount to client
int const::min_notify_msg_value()   asm "50000000 PUSHINT";   ;; 0.050 TON min msg_value on 0x7362d09c to auto-forward
int const::min_forward_gas()        asm "10000000 PUSHINT";   ;; 0.010 TON threshold for excess forwarding

;; ── Helper: Check if address is addr_none (2 bits == 0) ────────────────────
int is_addr_none(slice addr) inline {
    return addr.preload_uint(2) == 0;
}

;; ── Helper: Pack / Unpack Pending Deposit Entry ────────────────────────────
builder pack_pending_deposit(
    slice user_address,
    int   principal_nano,
    int   fee_nano,
    int   extra_gas,
    int   jetton_amount,
    int   created_at,
    int   status
) inline {
    return begin_cell()
        .store_slice(user_address)
        .store_coins(principal_nano)
        .store_coins(fee_nano)
        .store_coins(extra_gas)
        .store_coins(jetton_amount)
        .store_uint(created_at, 64)
        .store_uint(status, 8);
}

(slice, int, int, int, int, int, int) unpack_pending_deposit(slice s) inline {
    slice user_address   = s~load_msg_addr();
    int   principal_nano = s~load_coins();
    int   fee_nano       = s~load_coins();
    int   extra_gas      = s~load_coins();
    int   jetton_amount  = s.slice_bits() > 64 ? s~load_coins() : 0;
    int   created_at     = s~load_uint(64);
    int   status         = s.slice_bits() >= 8 ? s~load_uint(8) : 0;
    return (user_address, principal_nano, fee_nano, extra_gas, jetton_amount, created_at, status);
}

;; ── Helper: Find Earliest Deposit in status::pending_pool() (FIFO) ─────────
(int, slice, int) find_earliest_pending_pool(cell pending_deposits) inline {
    (int k, slice s, int f) = udict_get_min?(pending_deposits, 64);
    while (f) {
        slice copy_s = s;
        (_, _, _, _, _, _, int st) = unpack_pending_deposit(copy_s);
        if (st == status::pending_pool()) {
            return (k, s, -1);
        }
        (k, s, f) = udict_get_next?(pending_deposits, 64, k);
    }
    return (0, begin_cell().end_cell().begin_parse(), 0);
}

;; ── Helper: Build Outgoing 0x0f8a7ea5 (op::jetton_transfer) Message ────────
cell build_tston_transfer_msg(
    slice router_jwallet_address,
    int   ton_value,
    int   query_id,
    int   jetton_amount,
    slice user_address
) inline {
    cell transfer_body = begin_cell()
        .store_uint(op::jetton_transfer(), 32)
        .store_uint(query_id, 64)
        .store_coins(jetton_amount)
        .store_slice(user_address)            ;; destination: client wallet ONLY
        .store_slice(my_address())            ;; response_destination: Router receives 0xd53276db confirmation from user_jwallet
        .store_uint(0, 1)                     ;; custom_payload: null
        .store_coins(const::jetton_notify_gas())
        .store_uint(0, 1)                     ;; forward_payload: empty inline
        .end_cell();

    return begin_cell()
        .store_uint(0x18, 6)                  ;; bounce = true
        .store_slice(router_jwallet_address)
        .store_coins(ton_value)
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(transfer_body)
        .end_cell();
}

;; ── Storage Load / Save ────────────────────────────────────────────────────
(
    slice, ;; admin_address
    slice, ;; fee_recipient
    int,   ;; fee_bps
    int,   ;; paused
    int,   ;; network_id
    int,   ;; total_pending_escrow
    slice, ;; pool_address
    slice, ;; router_jwallet_address
    int,   ;; min_stake_nano
    int,   ;; partner_code
    int,   ;; timeout_sec
    int,   ;; total_principal_routed
    int,   ;; total_fees_collected
    int,   ;; total_tston_forwarded
    int,   ;; total_deposits_confirmed
    int,   ;; total_deposits_refunded
    cell,  ;; pending_deposits
    cell,  ;; completed_deposits
    cell,  ;; user_accounting
    cell   ;; refunded_deposits
) load_router_data() inline {
    slice ds = get_data().begin_parse();
    slice admin_address        = ds~load_msg_addr();
    slice fee_recipient        = ds~load_msg_addr();
    int   fee_bps              = ds~load_uint(16);
    int   paused               = ds~load_uint(1);
    int   network_id           = ds~load_int(16);
    int   total_pending_escrow = ds~load_coins();

    slice cfg = ds~load_ref().begin_parse();
    slice pool_address           = cfg~load_msg_addr();
    slice router_jwallet_address = cfg~load_msg_addr();
    int   min_stake_nano         = cfg~load_coins();
    int   partner_code           = cfg~load_uint(64);
    int   timeout_sec            = cfg~load_uint(32);

    slice st = ds~load_ref().begin_parse();
    int total_principal_routed   = st~load_coins();
    int total_fees_collected     = st~load_coins();
    int total_tston_forwarded    = st~load_coins();
    int total_deposits_confirmed = st~load_uint(64);
    int total_deposits_refunded  = st~load_uint(64);

    slice dc = ds~load_ref().begin_parse();
    cell pending_deposits   = dc~load_dict();
    cell completed_deposits = dc~load_dict();
    cell user_accounting    = dc~load_dict();
    cell refunded_deposits  = dc.slice_bits() > 0 ? dc~load_dict() : new_dict();

    return (
        admin_address,
        fee_recipient,
        fee_bps,
        paused,
        network_id,
        total_pending_escrow,
        pool_address,
        router_jwallet_address,
        min_stake_nano,
        partner_code,
        timeout_sec,
        total_principal_routed,
        total_fees_collected,
        total_tston_forwarded,
        total_deposits_confirmed,
        total_deposits_refunded,
        pending_deposits,
        completed_deposits,
        user_accounting,
        refunded_deposits
    );
}

() save_router_data(
    slice admin_address,
    slice fee_recipient,
    int   fee_bps,
    int   paused,
    int   network_id,
    int   total_pending_escrow,
    slice pool_address,
    slice router_jwallet_address,
    int   min_stake_nano,
    int   partner_code,
    int   timeout_sec,
    int   total_principal_routed,
    int   total_fees_collected,
    int   total_tston_forwarded,
    int   total_deposits_confirmed,
    int   total_deposits_refunded,
    cell  pending_deposits,
    cell  completed_deposits,
    cell  user_accounting,
    cell  refunded_deposits
) impure inline {
    cell cfg_cell = begin_cell()
        .store_slice(pool_address)
        .store_slice(router_jwallet_address)
        .store_coins(min_stake_nano)
        .store_uint(partner_code, 64)
        .store_uint(timeout_sec, 32)
        .end_cell();

    cell stats_cell = begin_cell()
        .store_coins(total_principal_routed)
        .store_coins(total_fees_collected)
        .store_coins(total_tston_forwarded)
        .store_uint(total_deposits_confirmed, 64)
        .store_uint(total_deposits_refunded, 64)
        .end_cell();

    cell dicts_cell = begin_cell()
        .store_dict(pending_deposits)
        .store_dict(completed_deposits)
        .store_dict(user_accounting)
        .store_dict(refunded_deposits)
        .end_cell();

    set_data(begin_cell()
        .store_slice(admin_address)
        .store_slice(fee_recipient)
        .store_uint(fee_bps, 16)
        .store_uint(paused, 1)
        .store_int(network_id, 16)
        .store_coins(total_pending_escrow)
        .store_ref(cfg_cell)
        .store_ref(stats_cell)
        .store_ref(dicts_cell)
        .end_cell()
    );
}

;; ── Helper: Update Per-Client On-Chain Accounting ──────────────────────────
cell update_user_stats(
    cell  user_accounting,
    slice user_address,
    int   add_principal,
    int   add_tston,
    int   add_fee,
    int   add_refund,
    int   add_deposit_count
) inline {
    int key = slice_hash(user_address);
    (slice existing, int found) = udict_get?(user_accounting, 256, key);

    int principal_staked = 0;
    int tston_received   = 0;
    int fees_paid        = 0;
    int refunded_amount  = 0;
    int deposit_count    = 0;

    if (found) {
        existing~load_msg_addr(); ;; skip stored address
        principal_staked = existing~load_coins();
        tston_received   = existing~load_coins();
        fees_paid        = existing~load_coins();
        refunded_amount  = existing~load_coins();
        deposit_count    = existing~load_uint(32);
    }

    builder updated = begin_cell()
        .store_slice(user_address)
        .store_coins(principal_staked + add_principal)
        .store_coins(tston_received + add_tston)
        .store_coins(fees_paid + add_fee)
        .store_coins(refunded_amount + add_refund)
        .store_uint(deposit_count + add_deposit_count, 32);

    user_accounting~udict_set_builder(256, key, updated);
    return user_accounting;
}

;; ── Bounce Handler: Pool Bounce (0x47d54391) & Jetton Transfer Bounce (0x0f8a7ea5) ──
() handle_bounce(slice sender_address, int msg_value, slice in_msg_body) impure inline {
    in_msg_body~skip_bits(32); ;; skip 0xffffffff bounce prefix
    if (in_msg_body.slice_bits() < 96) {
        return ();
    }
    int bounced_op = in_msg_body~load_uint(32);
    int query_id   = in_msg_body~load_uint(64);

    if ((bounced_op != op::tonstakers_deposit()) & (bounced_op != op::jetton_transfer())) {
        return ();
    }

    var (
        admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
        pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
        total_principal_routed, total_fees_collected, total_tston_forwarded,
        total_deposits_confirmed, total_deposits_refunded,
        pending_deposits, completed_deposits, user_accounting, refunded_deposits
    ) = load_router_data();

    ;; ── Case A: Tonstakers Pool bounced 0x47d54391 ─────────────────────────
    if (bounced_op == op::tonstakers_deposit()) {
        if (~ equal_slices(sender_address, pool_address)) {
            return ();
        }
        (slice pending_slice, int found) = udict_get?(pending_deposits, 64, query_id);
        if (~ found) {
            return ();
        }
        var (user_address, principal_nano, fee_nano, extra_gas, jetton_amount, created_at, status) = unpack_pending_deposit(pending_slice);
        if (status != status::pending_pool()) {
            return ();
        }
        pending_deposits~udict_delete?(64, query_id);

        int escrow_release = fee_nano + extra_gas;
        if (total_pending_escrow >= escrow_release) {
            total_pending_escrow -= escrow_release;
        } else {
            total_pending_escrow = 0;
        }

        builder refunded_val = begin_cell()
            .store_slice(user_address)
            .store_coins(principal_nano)
            .store_coins(fee_nano)
            .store_uint(now(), 64);
        refunded_deposits~udict_set_builder(64, query_id, refunded_val);

        total_deposits_refunded += 1;
        user_accounting = update_user_stats(
            user_accounting, user_address, 0, 0, 0, principal_nano + fee_nano, 0
        );

        int refund_amount = msg_value + fee_nano + extra_gas;
        var refund_msg = begin_cell()
            .store_uint(0x10, 6)
            .store_slice(user_address)
            .store_coins(refund_amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::stake_refunded(), 32)
            .store_uint(query_id, 64)
            .store_coins(principal_nano)
            .store_coins(fee_nano)
            .end_cell();
        send_raw_message(refund_msg, 1);

        save_router_data(
            admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
            pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
            total_principal_routed, total_fees_collected, total_tston_forwarded,
            total_deposits_confirmed, total_deposits_refunded,
            pending_deposits, completed_deposits, user_accounting, refunded_deposits
        );
        return ();
    }

    ;; ── Case B: Router tsTON Jetton Wallet bounced 0x0f8a7ea5 ──────────────
    if (bounced_op == op::jetton_transfer()) {
        if (~ equal_slices(sender_address, router_jwallet_address)) {
            return ();
        }
        (slice pending_slice, int found) = udict_get?(pending_deposits, 64, query_id);
        if (~ found) {
            return ();
        }
        var (user_address, principal_nano, fee_nano, extra_gas, jetton_amount, created_at, status) = unpack_pending_deposit(pending_slice);

        ;; B1: Normal delivery attempt (status == 1) bounced -> transition to status=2 (retryable).
        ;; Zero fee has been paid and deposit is NOT in completed_deposits!
        if (status == status::delivering_tston()) {
            builder updated_pending = pack_pending_deposit(
                user_address,
                principal_nano,
                fee_nano,
                extra_gas,
                jetton_amount,
                created_at,
                status::tston_bounced()
            );
            pending_deposits~udict_set_builder(64, query_id, updated_pending);

            save_router_data(
                admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
                pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
                total_principal_routed, total_fees_collected, total_tston_forwarded,
                total_deposits_confirmed, total_deposits_refunded,
                pending_deposits, completed_deposits, user_accounting, refunded_deposits
            );
            return ();
        }

        ;; B2: Recovery / no-mint probe after timeout_sec (status == 3) bounced:
        if (status == status::recovery_delivery()) {
            ;; If jetton_amount == 1 (the 1 nano-tsTON probe bounced with >= 0.105 TON gas),
            ;; router_jwallet_address cryptographically proved it holds 0 tsTON after timeout_sec!
            ;; Refund escrowed fee_nano + extra_gas + bounced msg_value to user_address.
            if (jetton_amount == 1) {
                pending_deposits~udict_delete?(64, query_id);

                int escrow_release = fee_nano + extra_gas;
                if (total_pending_escrow >= escrow_release) {
                    total_pending_escrow -= escrow_release;
                } else {
                    total_pending_escrow = 0;
                }

                builder refunded_val = begin_cell()
                    .store_slice(user_address)
                    .store_coins(principal_nano)
                    .store_coins(fee_nano)
                    .store_uint(now(), 64);
                refunded_deposits~udict_set_builder(64, query_id, refunded_val);

                total_deposits_refunded += 1;
                user_accounting = update_user_stats(
                    user_accounting, user_address, 0, 0, 0, fee_nano, 0
                );

                int refund_amount = msg_value + fee_nano + extra_gas;
                var refund_msg = begin_cell()
                    .store_uint(0x10, 6)
                    .store_slice(user_address)
                    .store_coins(refund_amount)
                    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                    .store_uint(op::stake_refunded(), 32)
                    .store_uint(query_id, 64)
                    .store_coins(principal_nano)
                    .store_coins(fee_nano)
                    .end_cell();
                send_raw_message(refund_msg, 1);
            } else {
                ;; User requested claim_jetton_amount > jwallet balance; revert status to 0
                ;; so user can retry with exact balance or probe with claim_jetton_amount = 1.
                builder reset_pending = pack_pending_deposit(
                    user_address,
                    principal_nano,
                    fee_nano,
                    extra_gas,
                    0,
                    created_at,
                    status::pending_pool()
                );
                pending_deposits~udict_set_builder(64, query_id, reset_pending);
            }

            save_router_data(
                admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
                pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
                total_principal_routed, total_fees_collected, total_tston_forwarded,
                total_deposits_confirmed, total_deposits_refunded,
                pending_deposits, completed_deposits, user_accounting, refunded_deposits
            );
            return ();
        }
    }
}

;; ── Main Internal Message Handler ──────────────────────────────────────────
() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice sender_address = cs~load_msg_addr();

    if (flags & 1) {
        handle_bounce(sender_address, msg_value, in_msg_body);
        return ();
    }
    if (in_msg_body.slice_empty?()) {
        return (); ;; Accept top-up TON for storage rent
    }

    int op       = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    var (
        admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
        pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
        total_principal_routed, total_fees_collected, total_tston_forwarded,
        total_deposits_confirmed, total_deposits_refunded,
        pending_deposits, completed_deposits, user_accounting, refunded_deposits
    ) = load_router_data();

    ;; ── 1. CLIENT STAKE DEPOSIT (Phase 1: Escrow Fee & Forward Principal) ──
    if (op == op::router_stake()) {
        throw_if(error::router_paused(), paused != 0);
        throw_unless(error::invalid_query_id(), query_id > 0);
        throw_if(error::jwallet_not_configured(), is_addr_none(router_jwallet_address));
        throw_unless(error::invalid_fee_bps(), fee_bps == const::fee_bps_exact());

        int principal_nano      = in_msg_body~load_coins();
        int expected_network_id = in_msg_body~load_int(16);

        throw_unless(error::wrong_network(), expected_network_id == network_id);
        throw_unless(error::below_min_stake(), principal_nano >= min_stake_nano);

        ;; Replay / collision protection across all 3 state dictionaries (pending, completed, refunded)
        (_, int found_pending)   = udict_get?(pending_deposits, 64, query_id);
        (_, int found_completed) = udict_get?(completed_deposits, 64, query_id);
        (_, int found_refunded)  = udict_get?(refunded_deposits, 64, query_id);
        throw_if(error::duplicate_query_id(), found_pending | found_completed | found_refunded);

        ;; Exact integer fee calculation on-chain: feeNano = (principalNano * 35) / 10000
        int fee_nano = muldiv(principal_nano, const::fee_bps_exact(), const::bps_denominator());

        int min_required = principal_nano + fee_nano + const::pool_deposit_gas() + const::router_processing_gas();
        throw_unless(error::insufficient_msg_value(), msg_value >= min_required);

        int extra_gas = msg_value - min_required;

        ;; Store pending deposit in status=0 (STATUS_PENDING_POOL)
        builder pending_val = pack_pending_deposit(
            sender_address,
            principal_nano,
            fee_nano,
            extra_gas,
            0,
            now(),
            status::pending_pool()
        );
        pending_deposits~udict_set_builder(64, query_id, pending_val);

        total_pending_escrow += (fee_nano + extra_gas);

        ;; Forward principal_nano + 1.0 TON gas reserve to Tonstakers Pool with bounce=1 (0x18)
        int pool_send_value = principal_nano + const::pool_deposit_gas();
        var pool_msg = begin_cell()
            .store_uint(0x18, 6) ;; bounce = true
            .store_slice(pool_address)
            .store_coins(pool_send_value)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::tonstakers_deposit(), 32)
            .store_uint(query_id, 64)
            .store_uint(partner_code, 64)
            .end_cell();
        send_raw_message(pool_msg, 1);

        save_router_data(
            admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
            pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
            total_principal_routed, total_fees_collected, total_tston_forwarded,
            total_deposits_confirmed, total_deposits_refunded,
            pending_deposits, completed_deposits, user_accounting, refunded_deposits
        );
        return ();
    }

    ;; ── 2. POOL MINT NOTIFICATION (Phase 2a: Queue/Send tsTON to Client) ───
    ;; IMPORTANT: Does NOT mark completed and does NOT pay the 0.35% fee yet!
    ;; Fee is released ONLY in Phase 2b (0xd53276db from user_jwallet_address)
    ;; after the client's tsTON Jetton Wallet has received the tokens!
    if (op == op::transfer_notification()) {
        throw_unless(error::unauthorized_jwallet(), equal_slices(sender_address, router_jwallet_address));

        int jetton_amount = in_msg_body~load_coins();
        throw_unless(error::zero_minted_jettons(), jetton_amount > 0);

        (slice pending_slice, int found) = udict_get?(pending_deposits, 64, query_id);

        ;; If query_id was altered by delayed round-end minting (e.g. query_id == 0),
        ;; match earliest FIFO deposit in status::pending_pool() so tsTON is never stranded!
        if (~ found) {
            (int fifo_key, slice fifo_slice, int fifo_found) = find_earliest_pending_pool(pending_deposits);
            throw_unless(error::unknown_pending_deposit(), fifo_found);
            query_id      = fifo_key;
            pending_slice = fifo_slice;
        }

        var (user_address, principal_nano, fee_nano, extra_gas, _, created_at, status) = unpack_pending_deposit(pending_slice);
        throw_unless(error::unknown_pending_deposit(), status == status::pending_pool());

        ;; Check if there is sufficient gas to safely execute 0x0f8a7ea5 (0.105 TON + extra_gas)
        int transfer_ton_value = const::jetton_transfer_gas() + extra_gas;
        int can_send_now = (msg_value >= const::min_notify_msg_value()) &
                           (my_balance >= (total_pending_escrow + const::jetton_transfer_gas()));

        if (can_send_now) {
            ;; Release extra_gas from escrow since it is attached to 0x0f8a7ea5
            if (total_pending_escrow >= extra_gas) {
                total_pending_escrow -= extra_gas;
            } else {
                total_pending_escrow = 0;
            }

            builder delivering_val = pack_pending_deposit(
                user_address,
                principal_nano,
                fee_nano,
                0,
                jetton_amount,
                created_at,
                status::delivering_tston()
            );
            pending_deposits~udict_set_builder(64, query_id, delivering_val);

            cell jetton_msg = build_tston_transfer_msg(
                router_jwallet_address,
                transfer_ton_value,
                query_id,
                jetton_amount,
                user_address
            );
            send_raw_message(jetton_msg, 1);
        } else {
            ;; Insufficient gas on 0x7362d09c: do NOT throw (0x7362d09c is non-bounceable!).
            ;; Record status=2 (STATUS_TSTON_BOUNCED) so 0x414e4c55 can deliver the tsTON.
            builder queued_val = pack_pending_deposit(
                user_address,
                principal_nano,
                fee_nano,
                extra_gas,
                jetton_amount,
                created_at,
                status::tston_bounced()
            );
            pending_deposits~udict_set_builder(64, query_id, queued_val);
        }

        save_router_data(
            admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
            pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
            total_principal_routed, total_fees_collected, total_tston_forwarded,
            total_deposits_confirmed, total_deposits_refunded,
            pending_deposits, completed_deposits, user_accounting, refunded_deposits
        );
        return ();
    }

    ;; ── 3. DELIVERY CONFIRMATION & EXCESS GAS FORWARDING (0xd53276db) ──────
    if (op == op::excesses()) {
        int is_pool_or_router_jwallet = equal_slices(sender_address, pool_address) |
                                        equal_slices(sender_address, router_jwallet_address);

        ;; 3A. If 0xd53276db comes from user_jwallet_address (neither pool nor router_jwallet)
        ;;     for a deposit in status==1 (DELIVERING) or status==3 (RECOVERY_DELIVERY):
        ;;     This confirms user_jwallet_address credited jetton_amount to user_address!
        ;;     Now we finalize completed_deposits[query_id] and pay the 0.35% fee!
        if (~ is_pool_or_router_jwallet) {
            (slice pending_slice, int found_pending) = udict_get?(pending_deposits, 64, query_id);
            if (found_pending) {
                var (user_address, principal_nano, fee_nano, extra_gas, jetton_amount, created_at, status) = unpack_pending_deposit(pending_slice);
                if ((status == status::delivering_tston()) | (status == status::recovery_delivery())) {
                    pending_deposits~udict_delete?(64, query_id);

                    int escrow_release = fee_nano + extra_gas;
                    if (total_pending_escrow >= escrow_release) {
                        total_pending_escrow -= escrow_release;
                    } else {
                        total_pending_escrow = 0;
                    }

                    builder completed_val = begin_cell()
                        .store_slice(user_address)
                        .store_coins(principal_nano)
                        .store_coins(fee_nano)
                        .store_coins(jetton_amount)
                        .store_uint(now(), 64);
                    completed_deposits~udict_set_builder(64, query_id, completed_val);

                    user_accounting = update_user_stats(
                        user_accounting,
                        user_address,
                        principal_nano,
                        jetton_amount,
                        fee_nano,
                        0,
                        1
                    );
                    total_principal_routed   += principal_nano;
                    total_fees_collected     += fee_nano;
                    total_tston_forwarded    += jetton_amount;
                    total_deposits_confirmed += 1;

                    ;; Send 0.35% ANLGRAM fee to fee_recipient (UQDW_PsjmeOBB_fvzOFmwqW7redEcufKQgImyrURvO7dbSYd)
                    if (fee_nano > 0) {
                        var fee_msg = begin_cell()
                            .store_uint(0x10, 6)
                            .store_slice(fee_recipient)
                            .store_coins(fee_nano)
                            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                            .store_uint(0, 32)
                            .store_slice("ANLGRAM Stake Fee 0.35%")
                            .end_cell();
                        send_raw_message(fee_msg, 1);
                    }

                    ;; Forward excess gas from user_jwallet_address to user_address
                    if (msg_value > const::min_forward_gas()) {
                        var excess_msg = begin_cell()
                            .store_uint(0x10, 6)
                            .store_slice(user_address)
                            .store_coins(0)
                            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                            .store_uint(op::excesses(), 32)
                            .store_uint(query_id, 64)
                            .end_cell();
                        send_raw_message(excess_msg, 64 + 2);
                    }

                    save_router_data(
                        admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
                        pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
                        total_principal_routed, total_fees_collected, total_tston_forwarded,
                        total_deposits_confirmed, total_deposits_refunded,
                        pending_deposits, completed_deposits, user_accounting, refunded_deposits
                    );
                    return ();
                }
            }
        }

        ;; 3B. Pool / Minter / router_jwallet excess gas forwarding (~0.887 TON) to user_address:
        if (msg_value > const::min_forward_gas()) {
            (slice comp_slice, int found_comp) = udict_get?(completed_deposits, 64, query_id);
            if (found_comp) {
                slice user_address = comp_slice~load_msg_addr();
                var excess_msg = begin_cell()
                    .store_uint(0x10, 6)
                    .store_slice(user_address)
                    .store_coins(0)
                    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                    .store_uint(op::excesses(), 32)
                    .store_uint(query_id, 64)
                    .end_cell();
                send_raw_message(excess_msg, 64 + 2);
                return ();
            }
            (slice pend_slice, int found_pend) = udict_get?(pending_deposits, 64, query_id);
            if (found_pend) {
                slice user_address = pend_slice~load_msg_addr();
                var excess_msg = begin_cell()
                    .store_uint(0x10, 6)
                    .store_slice(user_address)
                    .store_coins(0)
                    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                    .store_uint(op::excesses(), 32)
                    .store_uint(query_id, 64)
                    .end_cell();
                send_raw_message(excess_msg, 64 + 2);
                return ();
            }
        }
        return ();
    }

    ;; ── 4. NON-CUSTODIAL RETRY / RECOVERY OF tsTON DELIVERY (0x414e4c55) ───
    if (op == op::retry_tston_delivery()) {
        throw_unless(error::insufficient_msg_value(), msg_value >= const::jetton_transfer_gas());

        (slice pending_slice, int found) = udict_get?(pending_deposits, 64, query_id);
        throw_unless(error::unknown_pending_deposit(), found);

        var (user_address, principal_nano, fee_nano, extra_gas, jetton_amount, created_at, status) = unpack_pending_deposit(pending_slice);

        ;; Branch 4A: Retry bounced or gas-queued delivery (status == 2, jetton_amount already verified by 0x7362d09c)
        if (status == status::tston_bounced()) {
            throw_unless(error::zero_minted_jettons(), jetton_amount > 0);

            if (total_pending_escrow >= extra_gas) {
                total_pending_escrow -= extra_gas;
            } else {
                total_pending_escrow = 0;
            }

            builder retry_val = pack_pending_deposit(
                user_address,
                principal_nano,
                fee_nano,
                0,
                jetton_amount,
                created_at,
                status::delivering_tston()
            );
            pending_deposits~udict_set_builder(64, query_id, retry_val);

            cell jetton_msg = build_tston_transfer_msg(
                router_jwallet_address,
                msg_value + extra_gas,
                query_id,
                jetton_amount,
                user_address
            );
            send_raw_message(jetton_msg, 1);

            save_router_data(
                admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
                pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
                total_principal_routed, total_fees_collected, total_tston_forwarded,
                total_deposits_confirmed, total_deposits_refunded,
                pending_deposits, completed_deposits, user_accounting, refunded_deposits
            );
            return ();
        }

        ;; Branch 4B: Post-timeout recovery when 0x7362d09c never arrived (status == 0)
        if (status == status::pending_pool()) {
            throw_unless(error::access_denied(), equal_slices(sender_address, user_address));
            throw_unless(error::timeout_refund_disabled(), now() >= (created_at + timeout_sec));

            int claim_jetton_amount = in_msg_body.slice_bits() >= 4 ? in_msg_body~load_coins() : 1;
            throw_unless(error::zero_minted_jettons(), (claim_jetton_amount > 0) & (claim_jetton_amount <= principal_nano));

            builder rec_val = pack_pending_deposit(
                user_address,
                principal_nano,
                fee_nano,
                extra_gas,
                claim_jetton_amount,
                created_at,
                status::recovery_delivery()
            );
            pending_deposits~udict_set_builder(64, query_id, rec_val);

            cell jetton_msg = build_tston_transfer_msg(
                router_jwallet_address,
                msg_value,
                query_id,
                claim_jetton_amount,
                user_address
            );
            send_raw_message(jetton_msg, 1);

            save_router_data(
                admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
                pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
                total_principal_routed, total_fees_collected, total_tston_forwarded,
                total_deposits_confirmed, total_deposits_refunded,
                pending_deposits, completed_deposits, user_accounting, refunded_deposits
            );
            return ();
        }

        throw(error::no_bounced_tston());
    }

    ;; ── 5. UNILATERAL WALL-CLOCK TIMEOUT REFUND STRICTLY DISABLED (0x414e4c54) ──
    if (op == op::reclaim_timeout()) {
        throw(error::timeout_refund_disabled());
    }

    ;; ── 6. ADMIN: CONFIGURE ROUTER tsTON JETTON WALLET ─────────────────────
    if (op == op::set_router_jwallet()) {
        throw_unless(error::access_denied(), equal_slices(sender_address, admin_address));
        throw_unless(error::jwallet_locked(), dict_empty?(pending_deposits));
        slice new_jwallet = in_msg_body~load_msg_addr();
        throw_if(error::jwallet_not_configured(), is_addr_none(new_jwallet));
        save_router_data(
            admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
            pool_address, new_jwallet, min_stake_nano, partner_code, timeout_sec,
            total_principal_routed, total_fees_collected, total_tston_forwarded,
            total_deposits_confirmed, total_deposits_refunded,
            pending_deposits, completed_deposits, user_accounting, refunded_deposits
        );
        return ();
    }

    ;; ── 7. ADMIN: PAUSE / UNPAUSE NEW DEPOSITS ─────────────────────────────
    if (op == op::set_paused()) {
        throw_unless(error::access_denied(), equal_slices(sender_address, admin_address));
        int new_paused = in_msg_body~load_uint(1);
        save_router_data(
            admin_address, fee_recipient, fee_bps, new_paused, network_id, total_pending_escrow,
            pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
            total_principal_routed, total_fees_collected, total_tston_forwarded,
            total_deposits_confirmed, total_deposits_refunded,
            pending_deposits, completed_deposits, user_accounting, refunded_deposits
        );
        return ();
    }

    throw(error::unknown_op());
}

;; ═══════════════════════════════════════════════════════════════════════════
;; GET METHODS (Verifiable On-Chain State & Per-Client Accounting)
;; ═══════════════════════════════════════════════════════════════════════════

(slice, slice, int, int, int, int, slice, slice, int, int, int) get_router_config() method_id {
    var (
        admin_address, fee_recipient, fee_bps, paused, network_id, total_pending_escrow,
        pool_address, router_jwallet_address, min_stake_nano, partner_code, timeout_sec,
        _, _, _, _, _, _, _, _, _
    ) = load_router_data();
    return (
        admin_address,
        fee_recipient,
        fee_bps,
        paused,
        network_id,
        total_pending_escrow,
        pool_address,
        router_jwallet_address,
        min_stake_nano,
        partner_code,
        timeout_sec
    );
}

(int, int, int, int, int) get_router_stats() method_id {
    var (
        _, _, _, _, _, _,
        _, _, _, _, _,
        total_principal_routed, total_fees_collected, total_tston_forwarded,
        total_deposits_confirmed, total_deposits_refunded,
        _, _, _, _
    ) = load_router_data();
    return (
        total_principal_routed,
        total_fees_collected,
        total_tston_forwarded,
        total_deposits_confirmed,
        total_deposits_refunded
    );
}

(int, int) get_quote_for_principal(int principal_nano) method_id {
    int fee_nano = muldiv(principal_nano, const::fee_bps_exact(), const::bps_denominator());
    int min_total_nano = principal_nano + fee_nano + const::pool_deposit_gas() + const::router_processing_gas();
    return (fee_nano, min_total_nano);
}

(int, slice, int, int, int, int, int, int) get_pending_deposit(int query_id) method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, pending_deposits, _, _, _) = load_router_data();
    (slice s, int found) = udict_get?(pending_deposits, 64, query_id);
    if (~ found) {
        return (0, begin_cell().store_uint(0, 2).end_cell().begin_parse(), 0, 0, 0, 0, 0, 0);
    }
    var (user_address, principal_nano, fee_nano, extra_gas, jetton_amount, created_at, status) = unpack_pending_deposit(s);
    return (-1, user_address, principal_nano, fee_nano, extra_gas, created_at, status, jetton_amount);
}

(int, slice, int, int, int, int) get_completed_deposit(int query_id) method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, completed_deposits, _, _) = load_router_data();
    (slice s, int found) = udict_get?(completed_deposits, 64, query_id);
    if (~ found) {
        return (0, begin_cell().store_uint(0, 2).end_cell().begin_parse(), 0, 0, 0, 0);
    }
    slice user_address   = s~load_msg_addr();
    int   principal_nano = s~load_coins();
    int   fee_nano       = s~load_coins();
    int   tston_nano     = s~load_coins();
    int   completed_at   = s~load_uint(64);
    return (-1, user_address, principal_nano, fee_nano, tston_nano, completed_at);
}

(int, slice, int, int, int) get_refunded_deposit(int query_id) method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, refunded_deposits) = load_router_data();
    (slice s, int found) = udict_get?(refunded_deposits, 64, query_id);
    if (~ found) {
        return (0, begin_cell().store_uint(0, 2).end_cell().begin_parse(), 0, 0, 0);
    }
    slice user_address   = s~load_msg_addr();
    int   principal_nano = s~load_coins();
    int   fee_nano       = s~load_coins();
    int   refunded_at    = s~load_uint(64);
    return (-1, user_address, principal_nano, fee_nano, refunded_at);
}

(int, int, int, int, int, int) get_user_accounting(slice user_address) method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, user_accounting, _) = load_router_data();
    int key = slice_hash(user_address);
    (slice s, int found) = udict_get?(user_accounting, 256, key);
    if (~ found) {
        return (0, 0, 0, 0, 0, 0);
    }
    s~load_msg_addr();
    int principal_staked = s~load_coins();
    int tston_received   = s~load_coins();
    int fees_paid        = s~load_coins();
    int refunded_amount  = s~load_coins();
    int deposit_count    = s~load_uint(32);
    return (-1, principal_staked, tston_received, fees_paid, refunded_amount, deposit_count);
}
