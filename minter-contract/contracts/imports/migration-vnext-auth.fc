#include "vnext-permit-fields.fc";
int vn_migration_ready(int q,int balance) inline {
    ifnot(v2_local_ready(q,balance)) { return 0; }
    (_,_,_,_,_,_,_,_,_,slice expected_lp,slice expected_pton,_,_,_) = load_data();
    (cell intent,cell binding,_) = v2_parts();slice b = binding.begin_parse();b~load_msg_addr();b~load_msg_addr();slice lp = b~load_msg_addr();
    slice i = intent.begin_parse();i~skip_bits(135);slice e = i~load_ref().begin_parse();e~load_msg_addr();e~load_msg_addr();slice pton = e~load_msg_addr();
    return equal_slices(expected_lp,lp) & equal_slices(expected_pton,pton);
}
(int,int,int,int) vn_migration_registration() inline {
    cell r = v2_registration();if(cell_null?(r)) { return(0,0,0,0); }
    slice s = r.begin_parse();throw_unless(408,s~load_uint(32) == 0x4e585250);return(s~load_uint(64),s~load_uint(32),s~load_uint(256),s~load_uint(2));
}
() vn_save_migration_registration(int nonce,int deadline,int digest,int status,cell permit) impure inline {
    v2_store_registration(begin_cell().store_uint(0x4e585250,32).store_uint(nonce,64).store_uint(deadline,32).store_uint(digest,256).store_uint(status,2).store_ref(permit).end_cell());
}
cell vn_funding_snapshot(int q) inline {
    (_,cell f,_) = migration_life(q);return begin_cell().store_coins(life_get(f,0)).store_coins(life_get(f,1)).store_uint(life_get(f,4),64).store_uint(life_get(f,5),64).store_uint(life_get(f,6),64).end_cell();
}
int handle_vnext_migration_auth(int balance,int value,cell full,slice body) impure {
    if(body.slice_bits() < 96) { return 0; } slice h = full.begin_parse();int flags = h~load_uint(4);if(flags & 1) { return 0; } slice sender = h~load_msg_addr();int op = body~load_uint(32);int q = body~load_uint(64);
    if(op == 0x414e5a03) { throw(404); } ;; Legacy registration cannot authorize VNext.
    ifnot((op == 0x414e5b03) | (op == 0x414e5b11) | (op == 0x414e5b14) | (op == op::init_migration_wallets)) { return 0; }
    (cell intent,_,_) = v2_parts();throw_unless(409,q == v2_root(intent));
    (_,slice curve,slice guard,_,slice master,_,_,_,slice admin,_,_,_,_,_) = load_data();
    if(op == op::init_migration_wallets) {
        throw_unless(401,equal_slices(sender,admin));(cell i,cell bound,_) = v2_parts();throw_if(409,cell_null?(bound));
        slice b = bound.begin_parse();b~load_msg_addr();b~load_msg_addr();slice lp = b~load_msg_addr();slice s = i.begin_parse();s~skip_bits(135);s = s~load_ref().begin_parse();s~load_msg_addr();s~load_msg_addr();slice pton = s~load_msg_addr();
        throw_unless(408,equal_slices(body~load_msg_addr(),lp) & equal_slices(body~load_msg_addr(),pton));body.end_parse();return 0; ;; existing authenticated one-time setter persists these exact values
    }
    if((op == 0x414e5b11) | (op == 0x414e5b14)) {
        throw_unless(401,equal_slices(sender,curve) | equal_slices(sender,admin));throw_unless(407,value >= 80000000);throw_unless(409,vn_migration_ready(q,balance - value));
        int nonce = body~load_uint(64);int digest = body~load_uint(256);body.end_parse();throw_unless(409,nonce > 0);
        if(op == 0x414e5b14) {
            (int old,int deadline,int old_hash,int state) = vn_migration_registration();
            if(old) { throw_unless(409,(old == nonce) & (old_hash == digest) & (now() >= deadline) & (state != 1));slice ps = v2_registration().begin_parse();cell p = ps~load_ref();vn_save_migration_registration(old,deadline,digest,2,p); }
        }
        raw_reserve(balance - value,0);cell b = begin_cell().store_uint(op == 0x414e5b14 ? 0x414e5b04 : 0x414e5b01,32).store_uint(q,64).store_uint(nonce,64).store_uint(digest,256).store_ref(vn_funding_snapshot(q)).end_cell();
        send_raw_message(begin_cell().store_uint(0x18,6).store_slice(guard).store_coins(50000000).store_uint(1,107).store_ref(b).end_cell(),1);
        send_raw_message(begin_cell().store_uint(0x10,6).store_slice(sender).store_coins(0).store_uint(0,107).store_uint(0xd53276db,32).store_uint(q,64).end_cell(),128 + 2);return -1;
    }
    throw_unless(401,equal_slices(sender,guard));int revision = body~load_uint(64);int expiry = body~load_uint(32);int digest = body~load_uint(256);cell p = body~load_ref();body.end_parse();
    (int phase,int root,int nonce,int deadline,int ton,int tokens,_,int ce,int fe,int de,_,slice g,slice c,slice m,slice token,int commitment) = vn_fields(p);
    throw_unless(408,equal_slices(g,guard) & equal_slices(c,curve) & equal_slices(m,my_address()) & equal_slices(token,master) & (commitment == cell_hash(intent)));
    throw_unless(409,(phase == 2) & (root == q) & (revision == nonce) & (expiry == deadline) & (digest == cell_hash(p)) & vn_migration_ready(q,balance - value));
    (_,cell f,_) = migration_life(q);throw_unless(409,(ton == life_get(f,0)) & (tokens == life_get(f,1)) & (ce == life_get(f,4)) & (fe == life_get(f,5)) & (de == life_get(f,6)));
    (int old,int prior_end,int old_hash,int state) = vn_migration_registration();
    if(old) {
        if((old == nonce) & (old_hash == digest) & (state == 0)) { return_receipt_gas(admin,balance - value,q);return -1; }
        throw_unless(409,(nonce == old + 1) & (now() >= prior_end) & (state != 1));
    }
    vn_save_migration_registration(nonce,deadline,digest,0,p);return_receipt_gas(admin,balance - value,q);return -1;
}
() vn_require_execute(int q,slice body) impure inline {
    (cell intent,cell binding,_) = v2_parts();throw_unless(409,(q == v2_root(intent)) & (~ cell_null?(binding)) & vn_migration_ready(q,get_balance().pair_first()));
    slice token_wallet = body~load_msg_addr();slice lp_wallet = body~load_msg_addr();slice pton_wallet = body~load_msg_addr();int minimum = body~load_coins();slice authorization = body~load_ref().begin_parse();int nonce = authorization~load_uint(64);int digest = authorization~load_uint(256);authorization.end_parse();body.end_parse();
    (int expected,int expiry,int hash,int state) = vn_migration_registration();throw_unless(409,(nonce == expected) & (digest == hash) & (state == 0) & (now() < expiry));
    slice r = v2_registration().begin_parse();cell p = r~load_ref();(_,_,_,_,_,_,int min,_,_,_,_,_,_,_,_,_) = vn_fields(p);throw_unless(409,minimum == min);
    (_,_,_,slice dex,slice master,_,_,_,_,_,_,_,_,cell code) = load_data();slice own = calculate_user_jetton_wallet_address(dex,master,code);slice b = binding.begin_parse();b~load_msg_addr();b~load_msg_addr();throw_unless(408,equal_slices(token_wallet,own) & equal_slices(lp_wallet,b~load_msg_addr()));
    slice i = intent.begin_parse();i~skip_bits(135);slice e = i~load_ref().begin_parse();e~load_msg_addr();slice w0 = e~load_msg_addr();slice w1 = e~load_msg_addr();throw_unless(408,equal_slices(pton_wallet,equal_slices(w0,own) ? w1 : w0));
    throw(414); ;; SOURCE REVIEW / EXTERNAL SETTLEMENT PROOF GATE STAYS CLOSED.
}
(int,int,int,int,int) get_registration_vnext() method_id { (int n,int d,int h,int s) = vn_migration_registration();return(n,d,h,s,0); }
(int,int,int) get_protocol_vnext() method_id { return(1,1,0); }
