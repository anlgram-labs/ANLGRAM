;; The deployed canonical LP guard can only deny. Positive approval is a
;; narrowly scoped EXTERNAL dependency fixture in Sandbox, never a production bypass.
int curve_life_key(int q) inline { return cell_hash(begin_cell().store_uint(0x43555233,32).store_uint(q,64).end_cell()); }
cell curve_life_records() inline { (_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,cell d,_) = load_data();return d; }
() curve_life_save(cell d) impure inline {
    slice s = get_data().begin_parse();int state = s~load_uint(8);int fee = s~load_uint(16);cell a = s~load_ref();cell r = s~load_ref();
    slice old = s~load_ref().begin_parse();old~load_dict();cell wallet = old~load_ref();
    set_data(begin_cell().store_uint(state,8).store_uint(fee,16).store_ref(a).store_ref(r)
        .store_ref(begin_cell().store_dict(d).store_ref(wallet).end_cell()).end_cell());
}
int curve_life_flags(int q) inline { if((q <= 0) | (q >= (1 << 62))) { return -1; } (slice s,int ok) = curve_life_records().udict_get?(256,curve_life_key(q));return ok ? s~load_uint(3) : -1; }
() curve_life_flag(int q,int flags) impure inline { cell d = curve_life_records();d~udict_set_builder(256,curve_life_key(q),begin_cell().store_uint(flags,3));curve_life_save(d); }
int handle_curve_life(int op,int q,slice body,slice sender,int value,int balance) impure {
    ifnot((op >= 0x414e5801) & (op <= 0x414e5803) | (op == 0x414e5702) | (op == 0x414e5902)) { return 0; }
    (int state,slice admin,slice creator,slice treasury,slice master,slice wallet,slice dex,slice locker,slice migrator,
        int ton,int tokens,int fees,int claims,int vt,int vj,int threshold,int escrow,cell d,cell code) = load_data();
    throw_unless(409,settlement_enabled() & (q > 0) & (q < (1 << 62)));
    int flags = curve_life_flags(q);
    if(op == 0x414e5801) {
        throw_unless(401,equal_slices(sender,admin) | equal_slices(sender,creator));throw_unless(409,state == STATE_GRADUATION_PENDING);
        throw_unless(407,value >= 100000000);cell init = body~load_ref();body.end_parse();
        throw_unless(408,equal_slices(calculate_jetton_wallet_address(init),locker));
        slice si = init.begin_parse();throw_unless(408,si~load_uint(2) == 0);cell gc = si~load_dict();cell gd = si~load_dict();
        throw_unless(408,si~load_uint(1) == 0);si.end_parse();throw_unless(408,cell_hash(gc) == LP_AUTH_GUARD_CODE_HASH);
        slice gs = gd.begin_parse();throw_unless(408,(gs~load_uint(8) == 0) & (gs~load_uint(64) == 0));
        slice cfg = gs~load_ref().begin_parse();throw_unless(408,equal_slices(cfg~load_msg_addr(),dex) & equal_slices(cfg~load_msg_addr(),master));cfg~load_msg_addr();
        slice owner = cfg~load_ref().begin_parse();throw_unless(408,equal_slices(owner~load_msg_addr(),admin) & equal_slices(owner~load_msg_addr(),my_address()));
        (slice current,int active) = d.udict_get?(256,curve_life_key(0));
        if(active) {
            int prior = current~load_uint(64);
            if(prior != q) {
                (slice completed,int found) = d.udict_get?(256,curve_return_key(prior));throw_unless(409,found);
                int pt = completed~load_coins();int pj = completed~load_coins();
                throw_unless(409,(completed~load_coins() == pt) & (completed~load_coins() == pj));
            }
        }
        if(flags < 0) {
            throw_unless(409,(ton > 0) & (escrow > 0));(_,int used) = d.udict_get?(256,curve_return_key(q));throw_if(409,used);
            d~udict_set_builder(256,curve_return_key(q),curve_return_record(ton,escrow,0,0,0,null()));
            d~udict_set_builder(256,curve_life_key(q),begin_cell().store_uint(0,3));
            d~udict_set_builder(256,curve_life_key(0),begin_cell().store_uint(q,64));curve_life_save(d);
        }
        raw_reserve(balance - value,0);
        cell b = begin_cell().store_uint(sop::credit_open,32).store_uint(q + (1 << 62),64).store_slice(migrator).end_cell();
        send_raw_message(begin_cell().store_uint(0x18,6).store_slice(wallet).store_coins(30000000).store_uint(1,107).store_ref(b).end_cell(),1);
        send_raw_message(begin_cell().store_uint(0x18,6).store_slice(locker).store_coins(20000000).store_uint(0,107).store_uint(0x414e5701,32).store_uint(q,64).end_cell(),1);
        return -1;
    }
    throw_unless(409,flags >= 0);
    (slice r,_) = d.udict_get?(256,curve_return_key(q));int ot = r~load_coins();int oj = r~load_coins();r~load_coins();r~load_coins();int epoch = r~load_uint(64);
    if(op == 0x414e5702) {
        throw_unless(401,equal_slices(sender,locker));int allowed = body~load_uint(1);body.end_parse();
        if(allowed) { curve_life_flag(q,flags | 1); } return -1;
    }
    if(op == 0x414e5902) {
        throw_unless(401,equal_slices(sender,migrator));int ce = body~load_uint(64);int fe = body~load_uint(64);int de = body~load_uint(64);body.end_parse();
        throw_unless(409,(ce == epoch) & (epoch > 0) & (fe > 0) & (de > 0));curve_life_flag(q,flags | 2);return -1;
    }
    throw_unless(401,equal_slices(sender,admin) | equal_slices(sender,creator));body.end_parse();
    if(op == 0x414e5802) {
        throw_unless(409,epoch > 0);throw_unless(407,value >= 180000000);raw_reserve(balance - value,0);
        cell b = begin_cell().store_uint(0x414e5901,32).store_uint(q,64).store_coins(ot).store_coins(oj).store_uint(epoch,64).end_cell();
        send_raw_message(begin_cell().store_uint(0x18,6).store_slice(migrator).store_coins(140000000).store_uint(1,107).store_ref(b).end_cell(),1);return -1;
    }
    if(op == 0x414e5803) {
        if(flags & 4) { raw_reserve(balance - value,0);return_unreserved_gas(sender,q);return -1; }
        throw_unless(414,flags & 1);throw_unless(409,((flags & 2) != 0) & ((flags & 4) == 0) & (epoch > 0));
        throw_unless(409,(state == STATE_GRADUATION_PENDING) & (ton == ot) & (escrow == oj));throw_unless(407,value >= 250000000);
        save_data(STATE_MIGRATION_IN_PROGRESS,admin,creator,treasury,master,wallet,dex,locker,migrator,0,tokens,fees,claims,vt,vj,threshold,0,d,code);
        curve_life_flag(q,flags | 4);raw_reserve(balance - value - ton,0);
        cell b = begin_cell().store_uint(op::transfer(),32).store_uint(q + (1 << 63),64).store_coins(escrow)
            .store_slice(migrator).store_slice(my_address()).store_uint(0,1).store_coins(20000000).store_uint(0,1).end_cell();
        send_raw_message(begin_cell().store_uint(0x18,6).store_slice(wallet).store_coins(80000000).store_uint(1,107).store_ref(b).end_cell(),1);
        send_raw_message(begin_cell().store_uint(0x18,6).store_slice(migrator).store_coins(ton + 10000000).store_uint(0,107)
            .store_uint(op::deposit_ton_liquidity,32).store_uint(q,64).store_coins(ton).end_cell(),1);return -1;
    }
    return -1;
}
(int,int) get_curve_lifecycle(int q) method_id { return(curve_life_flags(q),q + (1 << 62)); }

int handle_curve_life_bounce(int balance,int value,cell full,slice body) impure {
    slice h = full.begin_parse();int flags = h~load_uint(4);ifnot(flags & 1) { return 0; }
    if(body.slice_bits() < 128) { return 0; } slice sender = h~load_msg_addr();body~load_uint(32);int op = body~load_uint(32);int wire = body~load_uint(64);
    int q = wire;int token = op == op::transfer();if(token) { if(wire < (1 << 63)) { return 0; } q = wire - (1 << 63); }
    elseif(op != op::deposit_ton_liquidity) { return 0; }
    if(curve_life_flags(q) < 0) { return 0; }
    (int state,slice admin,slice creator,slice treasury,slice master,slice wallet,slice dex,slice locker,slice migrator,
        int ton,int tokens,int fees,int claims,int vt,int vj,int threshold,int escrow,cell d,cell code) = load_data();
    throw_unless(401,equal_slices(sender,token ? wallet : migrator));
    (slice r,_) = d.udict_get?(256,curve_return_key(q));int ot = r~load_coins();int oj = r~load_coins();int rt = r~load_coins();int rj = r~load_coins();int epoch = r~load_uint(64);cell native_seen = r~load_dict();
    (slice initial,int found) = d.udict_get?(256,curve_funding_bounce_key(q));int it = 0;int ij = 0;cell seen = null();
    if(found) { it = initial~load_coins();ij = initial~load_coins();seen = initial~load_dict(); }
    int hash = cell_hash(full);(_,int duplicate) = seen.udict_get?(256,hash);if(duplicate) { return -1; }
    int amount = body~load_coins();throw_unless(409,amount > 0);
    if(token) { throw_unless(409,ij + amount <= oj);ij += amount;rj += amount;escrow += amount; }
    else { throw_unless(409,(it + amount <= ot) & (value >= amount));it += amount;rt += amount;ton += amount; }
    throw_unless(409,(rt <= ot) & (rj <= oj));seen~udict_set_builder(256,hash,begin_cell().store_uint(1,1));
    d~udict_set_builder(256,curve_funding_bounce_key(q),begin_cell().store_coins(it).store_coins(ij).store_dict(seen));
    d~udict_set_builder(256,curve_return_key(q),curve_return_record(ot,oj,rt,rj,epoch,native_seen));
    state = ((rt == ot) & (rj == oj)) ? STATE_GRADUATION_PENDING : STATE_MIGRATION_FAILED;
    save_data(state,admin,creator,treasury,master,wallet,dex,locker,migrator,ton,tokens,fees,claims,vt,vj,threshold,escrow,d,code);
    curve_return_ack(migrator,q,ot,oj,rt,rj,balance - value + (token ? 0 : amount));return -1;
}
