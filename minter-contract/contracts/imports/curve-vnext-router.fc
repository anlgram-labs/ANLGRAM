#include "migration-router-vnext-code.fc";
#include "lp-locker-v2-code.fc";
int curve_v2_local_ready() inline {
    (int state,_,_,_,_,_,_,_,_,int ton,int tokens,_,int claims,_,_,int threshold,int escrow,_,_) = load_data();
    return (state == STATE_GRADUATION_PENDING) & (threshold == 300000000000)
      & (ton >= threshold) & (tokens == 0) & (claims == 0) & (escrow == 200000000000000000);
}
() curve_v2_validate_request(int op,int q,slice sender) impure inline {
    if((op == 0x414e5801) | (op == 0x414e5803)) {
        (_,slice admin,slice creator,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_) = load_data();
        throw_unless(401,equal_slices(sender,admin) | equal_slices(sender,creator));
        throw_unless(409,(q > 0) & (q < (1 << 62)) & curve_v2_local_ready());
    }
}
(int,int) get_local_authorization_v2() method_id { return(curve_v2_local_ready(),0); }
() validate_v2_migrator(cell init,slice destination,slice curve,slice guard,slice dex,slice master,slice admin) impure inline {
    throw_unless(408,equal_slices(calculate_jetton_wallet_address(init),destination));slice s = init.begin_parse();throw_unless(408,s~load_uint(2) == 0);
    cell code = s~load_dict();cell data = s~load_dict();throw_unless(408,s~load_uint(1) == 0);s.end_parse();throw_unless(408,cell_hash(code) == MIGRATION_ROUTER_V2_CODE_HASH);
    s = data.begin_parse();throw_unless(408,s~load_uint(1) == 0);throw_unless(408,equal_slices(s~load_msg_addr(),curve) & equal_slices(s~load_msg_addr(),guard) & equal_slices(s~load_msg_addr(),dex));
    slice assets = s~load_ref().begin_parse();slice wallets = s~load_ref().begin_parse();slice flight = s~load_ref().begin_parse();s.end_parse();
    throw_unless(408,equal_slices(assets~load_msg_addr(),master));force_chain(assets~load_msg_addr());throw_unless(408,(assets~load_coins() == 0) & (assets~load_coins() == 0) & equal_slices(assets~load_msg_addr(),admin));assets.end_parse();
    throw_unless(408,(wallets~load_msg_addr().preload_uint(2) == 0) & (wallets~load_msg_addr().preload_uint(2) == 0));
    throw_unless(408,(wallets~load_coins() == 0) & (wallets~load_coins() == 0) & (cell_hash(wallets~load_ref()) == SETTLEMENT_WALLET_CODE_HASH));wallets.end_parse();
    throw_unless(408,(flight~load_uint(64) == 0) & (flight~load_uint(64) == 0) & (flight~load_uint(3) == 0));
    throw_unless(408,(flight~load_msg_addr().preload_uint(2) == 0) & (flight~load_msg_addr().preload_uint(2) == 0));cell ids = flight~load_dict();flight.end_parse();
    (slice r,int found) = ids.udict_get?(64,0);throw_unless(408,found);cell record = r~load_ref();r.end_parse();
    (ids,_) = ids.udict_delete?(64,0);throw_unless(408,cell_null?(ids));r = record.begin_parse();throw_unless(408,r~load_uint(32) == 0x4d563242);
    slice intent = r~load_ref().begin_parse();throw_unless(408,cell_null?(r~load_dict()) & cell_null?(r~load_dict()));r.end_parse();throw_unless(408,intent~load_uint(32) == 0x4c503249);
    int percent = intent~load_uint(7);int duration = intent~load_uint(32);int q = intent~load_uint(64);
    throw_unless(408,(percent >= 50) & (percent <= 100) & ((duration == 0) | (duration == 15552000) | (duration == 31536000)) & (q > 0) & (q < (1 << 62)));
}
