;; ANLGRAM Launchpad — STON.fi v2.1 Migration Router Smart Contract (Remediated TEP-74 & Recovery)
;; File: minter-contract/contracts/anlgram-migration-router.fc
;;
;; Features:
;; 1. Receives graduation reserves (TON + 200M DEX tokens) strictly from the authorized Curve:
;;    - TON via op::deposit_ton_liquidity (0x414e4c36) with msg_value >= deposit_ton.
;;    - Jettons via op::transfer_notification (0x7362d09c) strictly from the Migration Router's
;;      own deterministically derived TEP-74 Jetton wallet (owner = my_address(), master = token_minter_address)
;;      with from_address == curve_address.
;; 2. Configures the immutable LP Locker via op::set_lp_wallet (0x414e4c31).
;; 3. Sends TEP-74 op::transfer (0x0f8a7ea5) to the Migration Router's own Jetton wallet
;;    (my_jetton_wallet) with destination = dex_router_address and forward_payload = token_dex_payload.
;; 4. Formats official STON.fi v2.1 CPI Router messages using exact TL-B schema:
;;    provide_lp#37c096df token_wallet1:MsgAddress refund_address:MsgAddress excesses_address:MsgAddress
;;      tx_deadline:uint64 cross_provide_lp_body:^[min_lp_out:Coins to_address:MsgAddress both_positive:uint1 fwd_amount:Coins custom_payload:(Maybe ^Cell)]
;; 5. Formats pTON v2.1 ton_transfer#01f3835d forwarding the matched provide_lp payload with
;;    token_wallet1 set to the deterministically derived STON.fi Router ANLGRAM Jetton wallet.
;; 6. Preserves pending_ton and pending_tokens accounting during in-flight provision, handles bounced
;;    messages (flags & 1) and DEX refunds to restore balances, and returns BOTH TON and Jettons to
;;    the Bonding Curve upon op::abort_migration (0x414e4c38).

#include "imports/stdlib.fc";
#include "imports/params.fc";
#include "imports/constants.fc";
#include "imports/op-codes.fc";
#include "imports/utils.fc";
#include "imports/jetton-utils.fc";
#pragma version >=0.2.0;

const int ERROR_UNAUTHORIZED_SENDER = 401;
const int ERROR_INVALID_STATE       = 402;
const int ERROR_UNKNOWN_OP          = 404;
const int ERROR_INSUFFICIENT_GAS    = 405;
const int ERROR_ZERO_AMOUNT         = 406;
const int ERROR_ALREADY_INITIALIZED = 407;
const int ERROR_INVALID_ADDRESS     = 408;
const int ERROR_NO_TON_LIQUIDITY    = 410;
const int ERROR_NO_TOKEN_LIQUIDITY  = 411;
const int ERROR_NOTHING_TO_ABORT    = 412;

;; Protocol Opcodes
const int op::provide_lp             = 0x37c096df;
const int op::ton_transfer           = 0x01f3835d;
const int op::set_lp_wallet          = 0x414e4c31;
const int op::deposit_ton_liquidity  = 0x414e4c36;
const int op::execute_dex_provision  = 0x414e4c37;
const int op::abort_migration        = 0x414e4c38;
const int op::init_migration_wallets = 0x414e4c3b;

;; Minimum operational gas for execute_dex_provision (0.40 TON > 0.02 + 0.15 + 0.15 TON + fwd fees)
const int MIN_PROVISION_GAS          = 400000000;
;; Minimum operational gas for abort_migration when returning Jettons (0.08 TON)
const int MIN_ABORT_TOKEN_GAS        = 80000000;

;; Storage Layout:
;; Root cell:
;;   is_initialized:uint1 (0 = accumulating/ready, 1 = provision in-flight)
;;   curve_address:MsgAddress (addr_std)
;;   lp_locker_address:MsgAddress (addr_std)
;;   dex_router_address:MsgAddress (addr_std)
;;   ref c2:
;;     token_minter_address:MsgAddress (addr_std)
;;     pton_minter_address:MsgAddress (addr_std)
;;     ton_liquidity:Coins
;;     tokens_liquidity:Coins
;;     admin_address:MsgAddress (addr_std, strictly required — no fallback to curve_address)
;;   ref c3:
;;     expected_lp_wallet:MsgAddress (addr_none or addr_std)
;;     expected_pton_wallet:MsgAddress (addr_none or addr_std)
;;     pending_ton:Coins
;;     pending_tokens:Coins
;;     ref jetton_wallet_code:^Cell

(
    int, slice, slice, slice,
    slice, slice, int, int, slice,
    slice, slice, int, int, cell
) load_data() inline {
    slice ds = get_data().begin_parse();
    int is_initialized = ds~load_uint(1);
    slice curve_address = ds~load_msg_addr();
    slice lp_locker_address = ds~load_msg_addr();
    slice dex_router_address = ds~load_msg_addr();

    cell c2 = ds~load_ref();
    slice s2 = c2.begin_parse();
    slice token_minter_address = s2~load_msg_addr();
    slice pton_minter_address = s2~load_msg_addr();
    int ton_liquidity = s2~load_coins();
    int tokens_liquidity = s2~load_coins();
    slice admin_address = s2~load_msg_addr();
    s2.end_parse();

    cell c3 = ds~load_ref();
    slice s3 = c3.begin_parse();
    slice expected_lp_wallet = s3~load_msg_addr();
    slice expected_pton_wallet = s3~load_msg_addr();
    int pending_ton = s3~load_coins();
    int pending_tokens = s3~load_coins();
    cell jetton_wallet_code = s3~load_ref();
    s3.end_parse();
    ds.end_parse();

    throw_unless(ERROR_INVALID_ADDRESS, curve_address.preload_uint(2) == 2);
    throw_unless(ERROR_INVALID_ADDRESS, lp_locker_address.preload_uint(2) == 2);
    throw_unless(ERROR_INVALID_ADDRESS, dex_router_address.preload_uint(2) == 2);
    throw_unless(ERROR_INVALID_ADDRESS, token_minter_address.preload_uint(2) == 2);
    throw_unless(ERROR_INVALID_ADDRESS, pton_minter_address.preload_uint(2) == 2);
    throw_unless(ERROR_INVALID_ADDRESS, admin_address.preload_uint(2) == 2);

    return (
        is_initialized, curve_address, lp_locker_address, dex_router_address,
        token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
        expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
    );
}

() save_data(
    int is_initialized, slice curve_address, slice lp_locker_address, slice dex_router_address,
    slice token_minter_address, slice pton_minter_address, int ton_liquidity, int tokens_liquidity, slice admin_address,
    slice expected_lp_wallet, slice expected_pton_wallet, int pending_ton, int pending_tokens, cell jetton_wallet_code
) impure inline {
    set_data(begin_cell()
        .store_uint(is_initialized, 1)
        .store_slice(curve_address)
        .store_slice(lp_locker_address)
        .store_slice(dex_router_address)
        .store_ref(
            begin_cell()
                .store_slice(token_minter_address)
                .store_slice(pton_minter_address)
                .store_coins(ton_liquidity)
                .store_coins(tokens_liquidity)
                .store_slice(admin_address)
                .end_cell()
        )
        .store_ref(
            begin_cell()
                .store_slice(expected_lp_wallet)
                .store_slice(expected_pton_wallet)
                .store_coins(pending_ton)
                .store_coins(pending_tokens)
                .store_ref(jetton_wallet_code)
                .end_cell()
        )
        .end_cell()
    );
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice sender_address = cs~load_msg_addr();

    (
        int is_initialized, slice curve_address, slice lp_locker_address, slice dex_router_address,
        slice token_minter_address, slice pton_minter_address, int ton_liquidity, int tokens_liquidity, slice admin_address,
        slice expected_lp_wallet, slice expected_pton_wallet, int pending_ton, int pending_tokens, cell jetton_wallet_code
    ) = load_data();

    slice my_jetton_wallet = calculate_user_jetton_wallet_address(my_address(), token_minter_address, jetton_wallet_code);
    slice dex_router_token_wallet = calculate_user_jetton_wallet_address(dex_router_address, token_minter_address, jetton_wallet_code);

    ;; ------------------------------------------------------------------------
    ;; 0. BOUNCED MESSAGE RECOVERY (flags & 1)
    ;; ------------------------------------------------------------------------
    if (flags & 1) {
        if (in_msg_body.slice_bits() < 32) {
            return ();
        }
        in_msg_body~skip_bits(32); ;; 0xffffffff bounce prefix
        slice body_slice = in_msg_body;
        if ((body_slice.slice_bits() < 32) & (body_slice.slice_refs() > 0)) {
            body_slice = body_slice~load_ref().begin_parse();
        }
        if (body_slice.slice_bits() >= 32 + 64) {
            int orig_op = body_slice~load_uint(32);
            body_slice~skip_bits(64); ;; skip query_id

            ;; Case A: Bounced TEP-74 op::transfer from Migration Router's own Jetton Wallet
            if (equal_slices(sender_address, my_jetton_wallet) & (orig_op == op::transfer())) {
                int bounced_tokens = body_slice~load_coins();
                tokens_liquidity += bounced_tokens;
                if (pending_tokens >= bounced_tokens) {
                    pending_tokens -= bounced_tokens;
                } else {
                    pending_tokens = 0;
                }
                is_initialized = 0;
                save_data(
                    is_initialized, curve_address, lp_locker_address, dex_router_address,
                    token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
                    expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
                );
                return ();
            }

            ;; Case B: Bounced pTON op::ton_transfer from authenticated pTON Wallet
            if ((expected_pton_wallet.preload_uint(2) == 2) & equal_slices(sender_address, expected_pton_wallet) & (orig_op == op::ton_transfer)) {
                int bounced_ton = body_slice~load_coins();
                ton_liquidity += bounced_ton;
                if (pending_ton >= bounced_ton) {
                    pending_ton -= bounced_ton;
                } else {
                    pending_ton = 0;
                }
                is_initialized = 0;
                save_data(
                    is_initialized, curve_address, lp_locker_address, dex_router_address,
                    token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
                    expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
                );
                return ();
            }
        }
        return ();
    }

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    ;; ------------------------------------------------------------------------
    ;; 0B. ONE-TIME ADMIN WALLET BINDING (op::init_migration_wallets)
    ;; ------------------------------------------------------------------------
    if (op == op::init_migration_wallets) {
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, admin_address));
        throw_if(ERROR_ALREADY_INITIALIZED, (expected_lp_wallet.preload_uint(2) != 0) | (expected_pton_wallet.preload_uint(2) != 0));

        slice new_lp_wallet = in_msg_body~load_msg_addr();
        slice new_pton_wallet = in_msg_body~load_msg_addr();
        throw_unless(ERROR_INVALID_ADDRESS, new_lp_wallet.preload_uint(2) == 2);
        throw_unless(ERROR_INVALID_ADDRESS, new_pton_wallet.preload_uint(2) == 2);
        force_chain(new_lp_wallet);
        force_chain(new_pton_wallet);

        throw_if(ERROR_INVALID_ADDRESS,
            equal_slices(new_lp_wallet, new_pton_wallet) |
            equal_slices(new_lp_wallet, my_address()) |
            equal_slices(new_lp_wallet, my_jetton_wallet) |
            equal_slices(new_lp_wallet, dex_router_token_wallet) |
            equal_slices(new_lp_wallet, curve_address) |
            equal_slices(new_lp_wallet, lp_locker_address) |
            equal_slices(new_lp_wallet, dex_router_address) |
            equal_slices(new_pton_wallet, my_address()) |
            equal_slices(new_pton_wallet, my_jetton_wallet) |
            equal_slices(new_pton_wallet, dex_router_token_wallet) |
            equal_slices(new_pton_wallet, curve_address) |
            equal_slices(new_pton_wallet, lp_locker_address) |
            equal_slices(new_pton_wallet, dex_router_address)
        );

        expected_lp_wallet = new_lp_wallet;
        expected_pton_wallet = new_pton_wallet;
        save_data(
            is_initialized, curve_address, lp_locker_address, dex_router_address,
            token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
            expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
        );
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 1. RECEIVE TON LIQUIDITY FROM CURVE
    ;; ------------------------------------------------------------------------
    if (op == op::deposit_ton_liquidity) {
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, curve_address));
        throw_unless(ERROR_INVALID_STATE, is_initialized == 0);
        int deposit_ton = in_msg_body~load_coins();
        throw_unless(ERROR_ZERO_AMOUNT, deposit_ton > 0);
        throw_unless(ERROR_INSUFFICIENT_GAS, msg_value >= deposit_ton);

        ton_liquidity += deposit_ton;
        save_data(
            is_initialized, curve_address, lp_locker_address, dex_router_address,
            token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
            expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
        );
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 2. RECEIVE JETTON LIQUIDITY VIA AUTHENTICATED TRANSFER NOTIFICATION
    ;; ------------------------------------------------------------------------
    if (op == op::transfer_notification()) {
        ;; Gate 1: Sender MUST be the Migration Router's own TEP-74 Jetton Wallet for token_minter_address
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, my_jetton_wallet));

        int token_amount = in_msg_body~load_coins();
        slice from_address = in_msg_body~load_msg_addr();

        ;; Validate forward_payload structure (Either Cell ^Cell)
        throw_unless(ERROR_INVALID_ADDRESS, in_msg_body.slice_bits() >= 1);
        int has_ref = in_msg_body~load_uint(1);
        if (has_ref) {
            in_msg_body~load_ref();
        }

        ;; Gate 2: Positive token amount
        throw_unless(ERROR_ZERO_AMOUNT, token_amount > 0);

        ;; Gate 3: Previous owner (from_address) and contract state authentication
        if (is_initialized == 0) {
            ;; Initial graduation deposit must come strictly from the Bonding Curve
            throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(from_address, curve_address));
            tokens_liquidity += token_amount;
        } else {
            ;; When is_initialized == 1, accept token refund strictly from STON.fi DEX Router
            throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(from_address, dex_router_address));
            tokens_liquidity += token_amount;
            if (pending_tokens >= token_amount) {
                pending_tokens -= token_amount;
            } else {
                pending_tokens = 0;
            }
            is_initialized = 0;
        }

        save_data(
            is_initialized, curve_address, lp_locker_address, dex_router_address,
            token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
            expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
        );
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 2B. RECEIVE PTON / EXCESSES REFUND
    ;; ------------------------------------------------------------------------
    if (op == op::excesses()) {
        if ((is_initialized == 1) & (expected_pton_wallet.preload_uint(2) == 2) & equal_slices(sender_address, expected_pton_wallet) & (pending_ton > 0) & (msg_value >= pending_ton)) {
            ton_liquidity += pending_ton;
            pending_ton = 0;
            is_initialized = 0;
            save_data(
                is_initialized, curve_address, lp_locker_address, dex_router_address,
                token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
                expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
            );
        }
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 3. EXECUTE DEX LIQUIDITY PROVISION (STON.fi v2.1 Routing with Exact TL-B)
    ;; ------------------------------------------------------------------------
    if (op == op::execute_dex_provision) {
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, curve_address) | equal_slices(sender_address, admin_address));
        throw_if(ERROR_ALREADY_INITIALIZED, is_initialized == 1);
        throw_unless(ERROR_NO_TON_LIQUIDITY, ton_liquidity > 0);
        throw_unless(ERROR_NO_TOKEN_LIQUIDITY, tokens_liquidity > 0);
        throw_unless(ERROR_INSUFFICIENT_GAS, msg_value >= MIN_PROVISION_GAS);

        slice router_token_wallet = in_msg_body~load_msg_addr();
        slice lp_token_wallet     = in_msg_body~load_msg_addr();
        slice pton_wallet         = in_msg_body~load_msg_addr();

        ;; Authenticate all 3 DEX/LP wallet addresses:
        ;; 1. router_token_wallet MUST equal the deterministically derived TEP-74 Jetton wallet of dex_router_address
        throw_unless(ERROR_INVALID_ADDRESS, equal_slices(router_token_wallet, dex_router_token_wallet));
        ;; 2. lp_token_wallet and pton_wallet MUST match the pre-authenticated wallet addresses in storage
        throw_unless(ERROR_INVALID_ADDRESS, (expected_lp_wallet.preload_uint(2) == 2) & (expected_pton_wallet.preload_uint(2) == 2));
        throw_unless(ERROR_INVALID_ADDRESS, equal_slices(lp_token_wallet, expected_lp_wallet));
        throw_unless(ERROR_INVALID_ADDRESS, equal_slices(pton_wallet, expected_pton_wallet));
        throw_if(ERROR_INVALID_ADDRESS,
            equal_slices(lp_token_wallet, pton_wallet) |
            equal_slices(lp_token_wallet, my_jetton_wallet) |
            equal_slices(lp_token_wallet, dex_router_token_wallet) |
            equal_slices(pton_wallet, my_jetton_wallet) |
            equal_slices(pton_wallet, dex_router_token_wallet)
        );

        ;; Step A: Configure LP Locker with verified LP token wallet
        var set_lp_msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(lp_locker_address)
            .store_coins(20000000) ;; 0.02 TON
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::set_lp_wallet, 32)
            .store_uint(query_id, 64)
            .store_slice(lp_token_wallet);
        send_raw_message(set_lp_msg.end_cell(), 1);

        ;; Step B: Construct exact STON.fi v2.1 cross_provide_lp_body
        ;; cross_provide_lp_body:^[min_lp_out:Coins to_address:MsgAddress both_positive:uint1 fwd_amount:Coins custom_payload:(Maybe ^Cell)]
        cell cross_body = begin_cell()
            .store_coins(1)                     ;; min_lp_out: 1 unit minimum
            .store_slice(lp_locker_address)     ;; to_address: LP Locker receives all minted LP tokens!
            .store_uint(1, 1)                   ;; both_positive: true (both Token and TON > 0)
            .store_coins(20000000)              ;; fwd_amount: 0.02 TON
            .store_uint(0, 1)                   ;; null custom_payload
            .end_cell();

        ;; Step C: Construct DexPayload for Token Deposit
        ;; provide_lp#37c096df token_wallet1:MsgAddress refund_address:MsgAddress excesses_address:MsgAddress tx_deadline:uint64 cross_provide_lp_body:^Cell
        cell token_dex_payload = begin_cell()
            .store_uint(op::provide_lp, 32)
            .store_slice(pton_wallet)           ;; token_wallet1 (the paired STON.fi Router pTON wallet)
            .store_slice(my_address())          ;; refund_address: Migration Router for structured recovery
            .store_slice(my_address())          ;; excesses_address: Migration Router
            .store_uint(now() + 1800, 64)       ;; tx_deadline: 30 minutes
            .store_ref(cross_body)
            .end_cell();

        ;; Outbound TEP-74 Jetton Transfer of 200M Tokens:
        ;; Sent to my_jetton_wallet (Migration Router's own Jetton Wallet), with destination = dex_router_address!
        var jetton_msg_body = begin_cell()
            .store_uint(op::transfer(), 32)
            .store_uint(query_id, 64)
            .store_coins(tokens_liquidity)
            .store_slice(dex_router_address)    ;; destination: STON.fi DEX Router
            .store_slice(my_address())          ;; response_destination: Migration Router
            .store_uint(0, 1)                   ;; null custom payload
            .store_coins(100000000)             ;; forward 0.10 TON so receiver wallet sends transfer_notification to DEX Router
            .store_uint(1, 1)                   ;; forward payload in ref cell
            .store_ref(token_dex_payload)
            .end_cell();

        var jetton_msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(my_jetton_wallet)      ;; TEP-74 sender's own Jetton wallet (NOT router_token_wallet!)
            .store_coins(150000000)             ;; 0.15 TON attached gas
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(jetton_msg_body);
        send_raw_message(jetton_msg.end_cell(), 1);

        ;; Step D: Outbound pTON ton_transfer#01f3835d to pTON Wallet / Vault
        cell pton_dex_payload = begin_cell()
            .store_uint(op::provide_lp, 32)
            .store_slice(dex_router_token_wallet) ;; token_wallet1 (the paired STON.fi Router ANLGRAM Jetton wallet)
            .store_slice(my_address())            ;; refund_address: Migration Router
            .store_slice(my_address())            ;; excesses_address: Migration Router
            .store_uint(now() + 1800, 64)         ;; tx_deadline: 30 minutes
            .store_ref(cross_body)
            .end_cell();

        var ton_msg_body = begin_cell()
            .store_uint(op::ton_transfer, 32)   ;; 0x01f3835d
            .store_uint(query_id, 64)
            .store_coins(ton_liquidity)
            .store_slice(my_address())          ;; refund_address: Migration Router
            .store_uint(1, 1)                   ;; forward_payload as reference
            .store_ref(pton_dex_payload)
            .end_cell();

        var ton_msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(pton_wallet)
            .store_coins(ton_liquidity + 150000000) ;; principal + 0.15 TON operational gas
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(ton_msg_body);
        send_raw_message(ton_msg.end_cell(), 1);

        ;; Preserve dispatched amounts in pending_ton / pending_tokens for bounce/refund recovery
        pending_ton += ton_liquidity;
        pending_tokens += tokens_liquidity;
        ton_liquidity = 0;
        tokens_liquidity = 0;
        save_data(
            1, curve_address, lp_locker_address, dex_router_address,
            token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
            expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
        );
        return ();
    }

    ;; ------------------------------------------------------------------------
    ;; 4. OP::ABORT_MIGRATION (Emergency / Failure Refund of TON + Jettons to Curve)
    ;; ------------------------------------------------------------------------
    if (op == op::abort_migration) {
        throw_unless(ERROR_UNAUTHORIZED_SENDER, equal_slices(sender_address, curve_address) | equal_slices(sender_address, admin_address));
        throw_unless(ERROR_NOTHING_TO_ABORT, (ton_liquidity > 0) | (tokens_liquidity > 0));

        if (tokens_liquidity > 0) {
            throw_unless(ERROR_INSUFFICIENT_GAS, msg_value >= MIN_ABORT_TOKEN_GAS);

            var ret_jetton_body = begin_cell()
                .store_uint(op::transfer(), 32)
                .store_uint(query_id, 64)
                .store_coins(tokens_liquidity)
                .store_slice(curve_address)     ;; destination: Bonding Curve
                .store_slice(curve_address)     ;; response_destination: Bonding Curve
                .store_uint(0, 1)               ;; null custom_payload
                .store_coins(20000000)          ;; 0.02 TON forward amount so Curve receives transfer_notification
                .store_uint(0, 1)               ;; inline empty forward_payload
                .end_cell();

            var ret_jetton_msg = begin_cell()
                .store_uint(0x18, 6)
                .store_slice(my_jetton_wallet)
                .store_coins(60000000)          ;; 0.06 TON attached gas
                .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_ref(ret_jetton_body);
            send_raw_message(ret_jetton_msg.end_cell(), 1);
            tokens_liquidity = 0;
        }

        if (ton_liquidity > 0) {
            var ret_ton = begin_cell()
                .store_uint(0x18, 6)
                .store_slice(curve_address)
                .store_coins(ton_liquidity)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_uint(op::deposit_ton_liquidity, 32)
                .store_uint(query_id, 64)
                .store_coins(ton_liquidity);
            send_raw_message(ret_ton.end_cell(), 1);
            ton_liquidity = 0;
        }

        is_initialized = 0;
        save_data(
            is_initialized, curve_address, lp_locker_address, dex_router_address,
            token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity, admin_address,
            expected_lp_wallet, expected_pton_wallet, pending_ton, pending_tokens, jetton_wallet_code
        );
        return ();
    }

    throw(ERROR_UNKNOWN_OP);
}

;; Get Methods
(int, slice, slice, slice, slice, slice, int, int) get_migration_data() method_id {
    (
        int is_initialized, slice curve_address, slice lp_locker_address, slice dex_router_address,
        slice token_minter_address, slice pton_minter_address, int ton_liquidity, int tokens_liquidity, _,
        _, _, _, _, _
    ) = load_data();
    return (
        is_initialized, curve_address, lp_locker_address, dex_router_address,
        token_minter_address, pton_minter_address, ton_liquidity, tokens_liquidity
    );
}

(int, slice, slice, slice, int, int, slice, slice) get_migration_extended_data() method_id {
    (
        int is_initialized, _, _, slice dex_router_address,
        slice token_minter_address, _, _, _, slice admin_address,
        slice expected_lp_wallet, slice expected_pton_wallet, int pending_ton, int pending_tokens, cell jetton_wallet_code
    ) = load_data();
    slice my_jetton_wallet = calculate_user_jetton_wallet_address(my_address(), token_minter_address, jetton_wallet_code);
    slice dex_router_token_wallet = calculate_user_jetton_wallet_address(dex_router_address, token_minter_address, jetton_wallet_code);
    return (
        is_initialized, admin_address, expected_lp_wallet, expected_pton_wallet,
        pending_ton, pending_tokens, my_jetton_wallet, dex_router_token_wallet
    );
}
